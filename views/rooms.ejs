<%- include('partials/header') %>

<!-- Page Header Banner -->
<div style="background: linear-gradient(rgba(26, 38, 56, 0.75), rgba(26, 38, 56, 0.75)), url('/images/hotel-img-1.jpg') center/cover; padding: 70px 0; text-align: center; color: #fff;">
  <div class="container">
    <h1 style="font-size: 42px; margin-bottom: 10px; color: #ffffff;">Rooms Built Around the View</h1>
    <p style="color: var(--primary-blue); letter-spacing: 2px; text-transform: uppercase; font-weight: 600;">Three room types, one thing in common: a private balcony and a king bed waiting at the end of a Himalayan day.</p>
  </div>
</div>

<section class="section-padding">
  <div class="container">
    
    <!-- All Rooms Shared Features Strip -->
    <div style="background: var(--light-bg); padding: 30px; border-radius: 12px; margin-bottom: 45px; border: 1.5px solid #e2e8f0;">
      <h3 style="font-size: 22px; margin-bottom: 15px; text-align: center;">All Rooms at Flutter Hotels & Resorts Include:</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 15px; text-align: center;">
        <div style="background: #ffffff; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0;">
          <i class="fas fa-wifi" style="color: var(--primary-blue); font-size: 22px; margin-bottom: 6px;"></i>
          <h5 style="margin: 0; font-size: 14px;">Free High-Speed Wi-Fi</h5>
        </div>
        <div style="background: #ffffff; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0;">
          <i class="fas fa-tv" style="color: var(--primary-blue); font-size: 22px; margin-bottom: 6px;"></i>
          <h5 style="margin: 0; font-size: 14px;">32-inch Smart TV</h5>
        </div>
        <div style="background: #ffffff; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0;">
          <i class="fas fa-mug-hot" style="color: var(--primary-blue); font-size: 22px; margin-bottom: 6px;"></i>
          <h5 style="margin: 0; font-size: 14px;">Tea/Coffee Maker</h5>
        </div>
        <div style="background: #ffffff; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0;">
          <i class="fas fa-bottle-water" style="color: var(--primary-blue); font-size: 22px; margin-bottom: 6px;"></i>
          <h5 style="margin: 0; font-size: 14px;">Mineral Water</h5>
        </div>
        <div style="background: #ffffff; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0;">
          <i class="fas fa-door-closed" style="color: var(--primary-blue); font-size: 22px; margin-bottom: 6px;"></i>
          <h5 style="margin: 0; font-size: 14px;">Wardrobe & Storage</h5>
        </div>
        <div style="background: #ffffff; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0;">
          <i class="fas fa-mountain" style="color: var(--primary-blue); font-size: 22px; margin-bottom: 6px;"></i>
          <h5 style="margin: 0; font-size: 14px;">Private Balcony</h5>
        </div>
      </div>
    </div>

    <!-- Rooms Catalog Grid -->
    <div class="rooms-grid">
      <% rooms.forEach(room => { %>
        <div class="room-card">
          <div class="room-img-wrap">
            <img src="<%= room.image %>" alt="<%= room.name %>">
            <div class="room-price-badge">₹<%= room.price.toLocaleString() %> <span style="font-size: 12px; font-family: var(--font-sans);">/ Night</span></div>
          </div>
          <div class="room-card-body">
            <h3 class="room-title"><%= room.name %></h3>
            <div class="room-specs">
              <span><i class="fas fa-bed"></i> <%= room.bed %></span>
              <span><i class="fas fa-vector-square"></i> <%= room.size %></span>
              <span><i class="fas fa-eye"></i> <%= room.view %></span>
            </div>
            <p class="room-desc"><%= room.description %></p>
            <div class="room-card-footer">
              <a href="/rooms/<%= room.id %>" class="btn-outline-blue" style="padding: 8px 18px; font-size: 13px;">View Specs & FAQs</a>
              <a href="/rooms/<%= room.id %>" class="btn-blue" style="padding: 8px 18px; font-size: 13px;">Book This Room</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
