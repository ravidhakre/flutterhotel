<%- include('partials/header') %>

<!-- Rooms Hero Banner (Full-Height Mobile Responsive) -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.85)), url('/images/hotel-img-12.jpeg');">
  <div class="container" style="max-width: 900px; position: relative; z-index: 2;">
    <span style="background: rgba(245, 158, 11, 0.25); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 6px 20px; border-radius: 30px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: inline-block; margin-bottom: 18px; backdrop-filter: blur(4px);">
      <i class="fas fa-door-open"></i> Hillside & Valley View Stays
    </span>
    <h1 style="font-size: 44px; margin-bottom: 14px; color: #ffffff; font-family: 'Cinzel', serif; line-height: 1.25;">Rooms & Suites Built Around Hillside & Valley Views</h1>
    <p style="color: #cbd5e1; font-size: 16.5px; line-height: 1.7; max-width: 760px; margin: 0 auto 25px;">
      Three room categories with private balcony in all rooms, plush king bed, and uninterrupted valley views waiting at the end of a Lansdowne day.
    </p>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    
    <!-- All Rooms Shared Features Strip -->
    <div style="background: #ffffff; padding: 25px 30px; border-radius: 14px; margin-bottom: 50px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; text-align: center;">
        <div>
          <i class="fas fa-vector-square" style="font-size: 22px; color: var(--primary-blue); margin-bottom: 6px;"></i>
          <div style="font-size: 14px; font-weight: bold; color: var(--dark-bg);">Spacious 120-180 sq. ft.</div>
          <span style="font-size: 12px; color: #64748b;">Elegantly furnished spaces</span>
        </div>
        <div>
          <i class="fas fa-cloud-sun" style="font-size: 22px; color: #22c55e; margin-bottom: 6px;"></i>
          <div style="font-size: 14px; font-weight: bold; color: var(--dark-bg);">Private Balcony in All Rooms</div>
          <span style="font-size: 12px; color: #64748b;">Direct valley or lawn outlook</span>
        </div>
        <div>
          <i class="fas fa-wifi" style="font-size: 22px; color: #0284c7; margin-bottom: 6px;"></i>
          <div style="font-size: 14px; font-weight: bold; color: var(--dark-bg);">Free Wi-Fi</div>
          <span style="font-size: 12px; color: #64748b;">Seamless fiber connection</span>
        </div>
        <div>
          <i class="fas fa-concierge-bell" style="font-size: 22px; color: #f59e0b; margin-bottom: 6px;"></i>
          <div style="font-size: 14px; font-weight: bold; color: var(--dark-bg);">24/7 Room Service Desk</div>
          <span style="font-size: 12px; color: #64748b;">In-room dining & assistance</span>
        </div>
      </div>
    </div>

    <!-- Rooms Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
      <% rooms.forEach(room => { %>
        <div style="background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; display: flex; flex-direction: column; transition: transform 0.3s ease, box-shadow 0.3s ease;">
          
          <!-- Image Box with Swipeable Gallery Carousel -->
          <div style="position: relative; height: 250px; overflow: hidden;">
            <div style="display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; height: 100%; width: 100%;">
              <% (room.gallery || [room.image]).forEach((imgUrl, imgIdx) => { %>
                <div style="flex: 0 0 100%; scroll-snap-align: start; height: 100%; position: relative;">
                  <img src="<%= imgUrl %>" alt="<%= room.name %> - Photo <%= imgIdx + 1 %>" style="width: 100%; height: 100%; object-fit: cover;">
                  <span style="position: absolute; bottom: 12px; left: 12px; background: rgba(15,23,42,0.85); color: #ffffff; padding: 3px 10px; border-radius: 12px; font-size: 10.5px; font-weight: 600; backdrop-filter: blur(4px);">
                    <% if(imgIdx === 0) { %><i class="fas fa-bed"></i> Bedroom Interior<% } else if(imgIdx === 1) { %><i class="fas fa-mountain"></i> Balcony View<% } else { %><i class="fas fa-shower"></i> Washroom<% } %>
                  </span>
                </div>
              <% }); %>
            </div>
            
            <% if (room.badge) { %>
              <span style="position: absolute; top: 12px; left: 12px; background: rgba(15, 23, 42, 0.85); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 4px 12px; border-radius: 20px; font-size: 10.5px; font-weight: 700; text-transform: uppercase; backdrop-filter: blur(4px); pointer-events: none;">
                <i class="fas fa-layer-group"></i> <%= room.badge %>
              </span>
            <% } %>

            <span style="position: absolute; top: 12px; right: 12px; background: rgba(15, 23, 42, 0.85); color: #ffffff; padding: 4px 12px; border-radius: 20px; font-size: 10.5px; font-weight: 600; backdrop-filter: blur(4px); pointer-events: none;">
              <i class="fas fa-arrows-left-right"></i> Scroll Photos (<%= (room.gallery || []).length %>)
            </span>

            <span style="position: absolute; bottom: 12px; right: 12px; background: var(--primary-blue); color: #ffffff; padding: 5px 14px; border-radius: 20px; font-size: 13.5px; font-weight: bold; box-shadow: 0 4px 15px rgba(0,0,0,0.25); pointer-events: none;">
              ₹<%= room.price.toLocaleString() %> <small style="font-size: 10px; font-weight: normal;">/ Night</small>
            </span>
          </div>

          <!-- Room Content Body -->
          <div style="padding: 28px; display: flex; flex-direction: column; flex-grow: 1;">
            <h3 style="font-size: 22px; color: var(--dark-bg); margin-bottom: 12px; font-family: 'Cinzel', serif;"><%= room.name %></h3>
            
            <!-- Quick Spec Pills -->
            <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 16px;">
              <span style="background: #f1f5f9; color: #334155; padding: 4px 9px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                <i class="fas fa-bed" style="color: var(--primary-blue);"></i> <%= room.bed %>
              </span>
              <span style="background: #f1f5f9; color: #334155; padding: 4px 9px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                <i class="fas fa-ruler-combined" style="color: var(--primary-blue);"></i> <%= room.size %>
              </span>
              <span style="background: #f1f5f9; color: #334155; padding: 4px 9px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                <i class="fas fa-mug-hot" style="color: #d97706;"></i> Tea Kettle
              </span>
              <span style="background: #f1f5f9; color: #334155; padding: 4px 9px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                <i class="fas fa-shower" style="color: #0284c7;"></i> Hot & Cold Water
              </span>
              <span style="background: #f1f5f9; color: #334155; padding: 4px 9px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                <i class="fas fa-bottle-water" style="color: #10b981;"></i> 2 R.O. Water
              </span>
              <span style="background: #f1f5f9; color: #334155; padding: 4px 9px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                <i class="fas fa-door-open" style="color: var(--primary-blue);"></i> Private Balcony
              </span>
            </div>

            <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;">
              <%= room.description %>
            </p>

            <!-- Amenities List -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 25px; padding-top: 15px; border-top: 1px solid #f1f5f9;">
              <span style="font-size: 12.5px; color: #475569;"><i class="fas fa-wifi" style="color: #22c55e;"></i> Free Fiber Wi-Fi</span>
              <span style="font-size: 12.5px; color: #475569;"><i class="fas fa-coffee" style="color: #22c55e;"></i> Tea/Coffee Maker</span>
              <span style="font-size: 12.5px; color: #475569;"><i class="fas fa-tv" style="color: #22c55e;"></i> 32" Smart LED TV</span>
              <span style="font-size: 12.5px; color: #475569;"><i class="fas fa-cloud-sun" style="color: #22c55e;"></i> Private Balcony</span>
            </div>

            <!-- Dual Action Buttons -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <a href="/rooms/<%= room.slug || room.id %>" class="btn-outline-blue" style="padding: 11px 0; font-size: 13px; text-align: center; font-weight: bold; border-radius: 8px;">
                <i class="fas fa-info-circle"></i> View Details
              </a>
              <a href="/checkout?room=<%= room.slug || room.id %>" class="btn-blue" style="padding: 11px 0; font-size: 13px; text-align: center; font-weight: bold; border-radius: 8px;">
                <i class="fas fa-calendar-check"></i> Book Now
              </a>
            </div>

          </div>

        </div>
      <% }); %>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
