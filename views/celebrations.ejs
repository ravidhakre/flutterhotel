    <div style="background: #ffffff; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 35px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; display: grid; grid-template-columns: 1.1fr 1fr; margin-bottom: 60px;" class="responsive-two-col">
