          <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20plan%20a%20Destination%20Wedding%20at%20Flutter%20Hotels." target="_blank" class="btn-blue" style="padding: 11px 26px; font-size: 14px; font-weight: bold; background: #25d366 !important; border-color: #25d366 !important;">
            <i class="fab fa-whatsapp"></i> Book Wedding Consultation
          </a>
        </div>
