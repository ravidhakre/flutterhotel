<%- include('partials/header') %>

<!-- Celebrations Hero Banner -->
<div style="background: linear-gradient(rgba(15, 23, 42, 0.82), rgba(15, 23, 42, 0.85)), url('/images/hotel-img-14.jpeg') center/cover no-repeat; padding: 90px 0 70px; text-align: center; color: #fff;">
  <div class="container" style="max-width: 900px;">
    <span style="background: rgba(245, 158, 11, 0.25); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 5px 18px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: inline-block; margin-bottom: 15px;">
      Hillside Weddings & Parties
    </span>
    <h1 style="font-size: 42px; margin-bottom: 12px; color: #ffffff; font-family: 'Cinzel', serif;">Celebrations & Milestone Events</h1>
    <p style="color: #cbd5e1; font-size: 16px; line-height: 1.7; max-width: 750px; margin: 0 auto 25px;">
      Create timeless memories for destination weddings, anniversary galas, birthday bashes, and private cocktail evenings overlooking the stunning Garhwal valley.
    </p>
    <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20plan%20a%20Destination%20Wedding%20/%20Celebration%20at%20Flutter%20Hotels." target="_blank" class="btn-blue pulsing-btn" style="padding: 13px 30px; font-size: 14px; font-weight: bold;">
      <i class="fas fa-glass-cheers"></i> Plan Your Destination Event
    </a>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-bottom: 50px;">
      <div style="background: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 6px 25px rgba(0,0,0,0.04); border: 1px solid #e2e8f0;">
        <img src="/images/hotel-img-5.jpeg" alt="Destination Wedding Lansdowne" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 25px;">
          <h3 style="font-size: 20px; color: var(--dark-bg); margin-bottom: 8px;">Destination Weddings</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.6;">
            Intimate 100–150 guest mountain weddings with floral lawn mandaps, folk Garhwali music, and customized catering.
          </p>
        </div>
      </div>

      <div style="background: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 6px 25px rgba(0,0,0,0.04); border: 1px solid #e2e8f0;">
        <img src="/images/hotel-img-8.jpg" alt="Anniversaries & Romantics" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 25px;">
          <h3 style="font-size: 20px; color: var(--dark-bg); margin-bottom: 8px;">Anniversaries & Romantics</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.6;">
            Private candlelight dinners under starry mountain skies with live acoustic guitar and floral room setup.
          </p>
        </div>
      </div>

      <div style="background: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 6px 25px rgba(0,0,0,0.04); border: 1px solid #e2e8f0;">
        <img src="/images/hotel-img-15.jpeg" alt="Birthdays & Reunion Parties" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 25px;">
          <h3 style="font-size: 20px; color: var(--dark-bg); margin-bottom: 8px;">Birthdays & Reunions</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.6;">
            High-energy lawn parties with bonfire, DJ sound system, live barbecue grills, and custom cake design.
          </p>
        </div>
      </div>
    </div>

    <!-- Contact Callout -->
    <div style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff; padding: 45px; border-radius: 16px; text-align: center; max-width: 850px; margin: 0 auto;">
      <h3 style="font-size: 28px; font-family: 'Cinzel', serif; margin-bottom: 12px;">Speak With Our Event Planner</h3>
      <p style="color: #cbd5e1; font-size: 15px; margin-bottom: 25px;">
        Call our dedicated wedding concierge desk at +91 89 2923 2740 or WhatsApp us for custom quotes & menu tasting.
      </p>
      <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20enquire%20about%20a%20Celebration%20/%20Wedding%20booking." target="_blank" class="btn-blue" style="background: #25d366 !important; border-color: #25d366 !important; padding: 13px 32px; font-size: 15px;">
        <i class="fab fa-whatsapp"></i> Chat on WhatsApp
      </a>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
