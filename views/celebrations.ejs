<%- include('partials/header') %>

<!-- Celebrations Hero Banner (Full-Height Mobile Responsive) -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.85)), url('/images/celebration-hero-banner.jpg');">
  <div class="container" style="max-width: 900px; position: relative; z-index: 2;">
    <span style="background: rgba(245, 158, 11, 0.25); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 6px 20px; border-radius: 30px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: inline-block; margin-bottom: 18px; backdrop-filter: blur(4px);">
      <i class="fas fa-glass-cheers"></i> Destination Weddings & Celebrations
    </span>
    <h1 style="font-size: 44px; margin-bottom: 14px; color: #ffffff; font-family: 'Cinzel', serif; line-height: 1.25;">Celebrations & Milestone Events</h1>
    <p style="color: #cbd5e1; font-size: 16.5px; line-height: 1.7; max-width: 760px; margin: 0 auto 25px;">
      Create timeless memories for destination weddings, anniversary galas, birthday bashes, and private cocktail evenings overlooking the stunning Garhwal valley.
    </p>
    <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20plan%20a%20Destination%20Wedding%20/%20Celebration%20at%20Flutter%20Hotels." target="_blank" class="btn-blue pulsing-btn" style="padding: 14px 32px; font-size: 15px; font-weight: bold;">
      <i class="fas fa-glass-cheers"></i> Plan Your Destination Event
    </a>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    
    <div style="text-align: center; max-width: 750px; margin: 0 auto 50px;">
      <span class="section-subtitle">Hillside Celebrations</span>
      <h2 class="section-title">Memorable Venues For Every Occasion</h2>
      <p style="color: #64748b; font-size: 15px;">
        From intimate candlelight anniversaries to grand 120-guest indoor & outdoor lawn weddings, Flutter Hotels & Resorts offers bespoke catering, floral decor, and professional event coordination.
      </p>
    </div>

    <!-- Celebrations Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px; margin-bottom: 60px;">
      
      <!-- Card 1: Destination Weddings -->
      <div style="background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; display: flex; flex-direction: column;">
        <div style="position: relative; height: 240px; overflow: hidden;">
          <img src="/images/destination-wedding-decor.jpg" alt="Destination Weddings Lansdowne" style="width: 100%; height: 100%; object-fit: cover;">
          <span style="position: absolute; top: 15px; right: 15px; background: rgba(15, 23, 42, 0.85); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 5px 14px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; backdrop-filter: blur(4px);">
            <i class="fas fa-heart"></i> Weddings & Mandaps
          </span>
        </div>
        <div style="padding: 28px; flex-grow: 1; display: flex; flex-direction: column;">
          <h3 style="font-size: 22px; color: var(--dark-bg); margin-bottom: 10px; font-family: 'Cinzel', serif;">Destination Weddings</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;">
            Intimate 100–150 guest mountain weddings with floral lawn mandaps, live Garhwali folk music, fairy-lit banquet, and customized catering menus.
          </p>
          <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20enquire%20about%20a%20Destination%20Wedding%20package." target="_blank" class="btn-outline-blue" style="padding: 11px 0; font-size: 13px; text-align: center; font-weight: bold; border-radius: 8px;">
            <i class="fab fa-whatsapp"></i> Get Wedding Quote
          </a>
        </div>
      </div>

      <!-- Card 2: Anniversaries & Romantics -->
      <div style="background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; display: flex; flex-direction: column;">
        <div style="position: relative; height: 240px; overflow: hidden;">
          <img src="/images/romantic-candlelight-dinner.jpg" alt="Anniversaries & Romantics" style="width: 100%; height: 100%; object-fit: cover;">
          <span style="position: absolute; top: 15px; right: 15px; background: rgba(15, 23, 42, 0.85); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 5px 14px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; backdrop-filter: blur(4px);">
            <i class="fas fa-wine-glass-alt"></i> Romantic Dining
          </span>
        </div>
        <div style="padding: 28px; flex-grow: 1; display: flex; flex-direction: column;">
          <h3 style="font-size: 22px; color: var(--dark-bg); margin-bottom: 10px; font-family: 'Cinzel', serif;">Anniversaries & Romantics</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;">
            Private candlelight dinners under starry mountain skies with live acoustic music, special room bed decoration with fresh flowers, and champagne.
          </p>
          <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20enquire%20about%20a%20Romantic%20Candlelight%20Dinner%20/%20Anniversary." target="_blank" class="btn-outline-blue" style="padding: 11px 0; font-size: 13px; text-align: center; font-weight: bold; border-radius: 8px;">
            <i class="fab fa-whatsapp"></i> Book Romantic Dinner
          </a>
        </div>
      </div>

      <!-- Card 3: Birthdays & Reunions -->
      <div style="background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; display: flex; flex-direction: column;">
        <div style="position: relative; height: 240px; overflow: hidden;">
          <img src="/images/birthday-lawn-party.jpg" alt="Birthdays & Reunion Parties" style="width: 100%; height: 100%; object-fit: cover;">
          <span style="position: absolute; top: 15px; right: 15px; background: rgba(15, 23, 42, 0.85); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 5px 14px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; backdrop-filter: blur(4px);">
            <i class="fas fa-cake-candles"></i> Lawn Parties
          </span>
        </div>
        <div style="padding: 28px; flex-grow: 1; display: flex; flex-direction: column;">
          <h3 style="font-size: 22px; color: var(--dark-bg); margin-bottom: 10px; font-family: 'Cinzel', serif;">Birthdays & Reunions</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;">
            High-energy lawn parties with warm evening bonfire, DJ sound system, live barbecue grills, custom cake design, and family activities.
          </p>
          <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20enquire%20about%20a%20Birthday%20Party%20/%20Family%20Reunion." target="_blank" class="btn-outline-blue" style="padding: 11px 0; font-size: 13px; text-align: center; font-weight: bold; border-radius: 8px;">
            <i class="fab fa-whatsapp"></i> Plan Birthday Party
          </a>
        </div>
      </div>

    </div>

    <!-- Contact Callout -->
    <div style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff; padding: 45px; border-radius: 16px; text-align: center; max-width: 850px; margin: 0 auto; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
      <h3 style="font-size: 28px; font-family: 'Cinzel', serif; margin-bottom: 12px; color: #ffffff;">Speak With Our Event Planner</h3>
      <p style="color: #cbd5e1; font-size: 15px; margin-bottom: 25px;">
        Call our dedicated wedding concierge desk at +91 89 2923 2740 or WhatsApp us for custom event quotes & menu tasting.
      </p>
      <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20enquire%20about%20a%20Celebration%20/%20Wedding%20booking." target="_blank" class="btn-blue" style="background: #25d366 !important; border-color: #25d366 !important; padding: 13px 32px; font-size: 15px;">
        <i class="fab fa-whatsapp"></i> Chat on WhatsApp
      </a>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
