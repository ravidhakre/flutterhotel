<%- include('partials/header') %>

<!-- Package Detail Hero Header -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.85)), url('<%= packageItem.image %>');">
  <div class="container" style="max-width: 900px; position: relative; z-index: 2;">
    <span style="background: rgba(245, 158, 11, 0.25); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 6px 20px; border-radius: 30px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: inline-block; margin-bottom: 18px; backdrop-filter: blur(4px);">
      <i class="fas fa-star"></i> <%= packageItem.tag %>
    </span>
    <h1 style="font-size: 42px; margin-bottom: 14px; color: #ffffff; font-family: 'Cinzel', serif; line-height: 1.3;"><%= packageItem.title %></h1>
    <p style="color: #cbd5e1; font-size: 16.5px; line-height: 1.7; max-width: 760px; margin: 0 auto 20px;">
      <%= packageItem.shortDesc %>
    </p>
    <div style="display: inline-flex; align-items: baseline; gap: 8px; background: rgba(255,255,255,0.15); padding: 8px 24px; border-radius: 30px; backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,0.3);">
      <span style="font-size: 24px; font-weight: bold; color: #ffffff;"><%= packageItem.price %></span>
    </div>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 40px;" class="responsive-two-col">
      
      <!-- Main Content Left -->
      <div>
        
        <!-- Package Feature Banner Image -->
        <div style="border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; margin-bottom: 35px; height: 380px;">
          <img src="<%= packageItem.image %>" alt="<%= packageItem.title %>" style="width: 100%; height: 100%; object-fit: cover;">
        </div>

        <h3 style="font-size: 26px; color: var(--dark-bg); margin-bottom: 18px; font-family: 'Cinzel', serif;">What’s Included in This Package</h3>
        <div style="background: #ffffff; padding: 30px; border-radius: 14px; border: 1px solid #e2e8f0; margin-bottom: 40px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px;">
            <% packageItem.inclusions.forEach(function(inc) { %>
              <li style="font-size: 15px; color: #334155; display: flex; align-items: flex-start; gap: 12px; line-height: 1.6;">
                <i class="fas fa-circle-check" style="color: #22c55e; margin-top: 3px; font-size: 18px; flex-shrink: 0;"></i>
                <span><%= inc %></span>
              </li>
            <% }); %>
          </ul>
        </div>

        <% if (packageItem.itinerary && packageItem.itinerary.length > 0) { %>
          <h3 style="font-size: 26px; color: var(--dark-bg); margin-bottom: 18px; font-family: 'Cinzel', serif;">Day-by-Day Itinerary</h3>
          <div style="display: flex; flex-direction: column; gap: 18px; margin-bottom: 40px;">
            <% packageItem.itinerary.forEach(function(it) { %>
              <div style="background: #ffffff; padding: 24px; border-radius: 14px; border: 1px solid #e2e8f0; border-left: 4px solid var(--primary-blue); box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
                <span style="font-size: 12px; font-weight: bold; color: var(--primary-blue); text-transform: uppercase; letter-spacing: 1px;"><%= it.day %></span>
                <h4 style="font-size: 18px; color: var(--dark-bg); margin: 4px 0 8px;"><%= it.title %></h4>
                <p style="color: #64748b; font-size: 14.5px; margin: 0; line-height: 1.6;"><%= it.desc %></p>
              </div>
            <% }); %>
          </div>
        <% } %>

        <% if (packageItem.faqs && packageItem.faqs.length > 0) { %>
          <h3 style="font-size: 26px; color: var(--dark-bg); margin-bottom: 18px; font-family: 'Cinzel', serif;">Frequently Asked Questions</h3>
          <div style="display: flex; flex-direction: column; gap: 15px; margin-bottom: 40px;">
            <% packageItem.faqs.forEach(function(faq) { %>
              <div style="background: #ffffff; padding: 22px; border-radius: 12px; border: 1px solid #e2e8f0;">
                <h4 style="font-size: 16px; color: var(--dark-bg); margin-bottom: 6px;"><i class="fas fa-circle-question" style="color: var(--primary-blue);"></i> <%= faq.q %></h4>
                <p style="color: #64748b; font-size: 14px; margin: 0; line-height: 1.6;"><%= faq.a %></p>
              </div>
            <% }); %>
          </div>
        <% } %>

      </div>

      <!-- Instant Booking Sidebar Right -->
      <div>
        <div style="background: #ffffff; padding: 32px; border-radius: 16px; border: 1.5px solid #e2e8f0; box-shadow: 0 10px 35px rgba(0,0,0,0.06); position: sticky; top: 100px;">
          <div style="text-align: center; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 15px;">
            <span style="font-size: 12px; font-weight: bold; color: var(--primary-blue); text-transform: uppercase; letter-spacing: 1px;">Direct Reservation</span>
            <h3 style="font-size: 20px; color: var(--dark-bg); margin: 4px 0 6px; font-family: 'Cinzel', serif;"><%= packageItem.title %></h3>
            <div style="font-size: 22px; font-weight: bold; color: #1e293b;"><%= packageItem.price %></div>
          </div>

          <a href="/checkout?type=package&package=<%= packageItem.slug %>" class="btn-blue pulsing-btn" style="width: 100%; padding: 14px 20px; font-size: 15px; font-weight: bold; text-align: center; display: block; border-radius: 8px; margin-bottom: 15px;">
            <i class="fas fa-calendar-check"></i> Book Package Now
          </a>

          <div style="text-align: center; font-size: 13px; color: #64748b; margin-bottom: 20px;">
            <i class="fas fa-shield-halved" style="color: #22c55e;"></i> Best Package Tariff Guaranteed
          </div>

          <div style="background: #f8fafc; padding: 18px; border-radius: 10px; border: 1px solid #e2e8f0; text-align: center;">
            <span style="font-size: 12px; color: #64748b; display: block; margin-bottom: 6px;">Need Custom Itinerary or Large Group Booking?</span>
            <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20enquire%20about%20the%20<%= encodeURIComponent(packageItem.title) %>." target="_blank" style="color: #25d366; font-weight: bold; font-size: 14px; text-decoration: none;">
              <i class="fab fa-whatsapp"></i> Chat with Package Concierge
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<%- include('partials/footer') %>
