<%- include('partials/header') %>

<!-- Room Detail Hero Header -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.85)), url('<%= room.image %>');">
  <div class="container" style="max-width: 900px; position: relative; z-index: 2;">
    <span style="background: rgba(245, 158, 11, 0.25); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 6px 20px; border-radius: 30px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: inline-block; margin-bottom: 18px; backdrop-filter: blur(4px);">
      <i class="fas fa-bed"></i> <%= room.category %> Accommodations
    </span>
    <h1 style="font-size: 42px; margin-bottom: 14px; color: #ffffff; font-family: 'Cinzel', serif; line-height: 1.3;"><%= room.name %></h1>
    <div style="display: inline-flex; align-items: baseline; gap: 8px; background: rgba(255,255,255,0.15); padding: 8px 24px; border-radius: 30px; backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,0.3);">
      <span style="font-size: 28px; font-weight: bold; color: #ffffff;">₹<%= room.price.toLocaleString() %></span>
      <span style="font-size: 14px; color: #cbd5e1;">/ Night (Inclusive of Taxes)</span>
    </div>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 40px;" class="responsive-two-col">
      
      <!-- Main Content Left -->
      <div>
        <!-- Main Room Image -->
        <div style="border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; margin-bottom: 20px; height: 420px;">
          <img id="mainRoomImage" src="<%= room.image %>" alt="<%= room.name %>" style="width: 100%; height: 100%; object-fit: cover;">
        </div>

        <!-- Gallery Thumbnails -->
        <% if (room.gallery && room.gallery.length > 0) { %>
          <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 35px;">
            <% room.gallery.forEach((img, idx) => { %>
              <div onclick="document.getElementById('mainRoomImage').src='<%= img %>'" style="height: 90px; border-radius: 10px; overflow: hidden; cursor: pointer; border: 2px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
                <img src="<%= img %>" alt="Gallery Photo <%= idx + 1 %>" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
            <% }); %>
          </div>
        <% } %>

        <h3 style="font-size: 26px; color: var(--dark-bg); margin-bottom: 14px; font-family: 'Cinzel', serif;">Room Overview & Features</h3>
        <p style="color: #475569; font-size: 15.5px; line-height: 1.8; margin-bottom: 30px;">
          <%= room.description %>
        </p>

        <!-- Room Specs Bar -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 20px; background: #ffffff; padding: 25px; border-radius: 14px; margin-bottom: 40px; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
          <div>
            <span style="display: block; font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: bold; margin-bottom: 4px;">Room Size</span>
            <strong style="font-size: 15px; color: var(--dark-bg);"><i class="fas fa-ruler-combined" style="color: var(--primary-blue);"></i> <%= room.size %></strong>
          </div>
          <div>
            <span style="display: block; font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: bold; margin-bottom: 4px;">Bed Type</span>
            <strong style="font-size: 15px; color: var(--dark-bg);"><i class="fas fa-bed" style="color: var(--primary-blue);"></i> <%= room.bed %></strong>
          </div>
          <div>
            <span style="display: block; font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: bold; margin-bottom: 4px;">Max Occupancy</span>
            <strong style="font-size: 15px; color: var(--dark-bg);"><i class="fas fa-users" style="color: var(--primary-blue);"></i> <%= room.capacity %> Guests</strong>
          </div>
          <div>
            <span style="display: block; font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: bold; margin-bottom: 4px;">Balcony Outlook</span>
            <strong style="font-size: 15px; color: var(--dark-bg);"><i class="fas fa-mountain" style="color: var(--primary-blue);"></i> <%= room.view %></strong>
          </div>
        </div>

        <h3 style="font-size: 24px; color: var(--dark-bg); margin-bottom: 20px; font-family: 'Cinzel', serif;">Included Amenities</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 45px; background: #ffffff; padding: 25px; border-radius: 14px; border: 1px solid #e2e8f0;">
          <% room.amenities.forEach(amenity => { %>
            <div style="display: flex; align-items: center; gap: 10px; font-size: 14.5px; color: #334155;">
              <i class="fas fa-circle-check" style="color: #22c55e;"></i>
              <span><%= amenity %></span>
            </div>
          <% }); %>
        </div>

      </div>

      <!-- Instant Booking Sidebar Right -->
      <div>
        <div style="background: #ffffff; padding: 32px; border-radius: 16px; border: 1.5px solid #e2e8f0; box-shadow: 0 10px 35px rgba(0,0,0,0.06); position: sticky; top: 100px;">
          <div style="text-align: center; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 15px;">
            <span style="font-size: 12px; font-weight: bold; color: var(--primary-blue); text-transform: uppercase; letter-spacing: 1px;">Direct Reservation</span>
            <h3 style="font-size: 22px; color: var(--dark-bg); margin: 4px 0 6px; font-family: 'Cinzel', serif;">Book <%= room.name %></h3>
            <div style="font-size: 24px; font-weight: bold; color: #1e293b;">₹<%= room.price.toLocaleString() %> <small style="font-size: 12px; font-weight: normal; color: #64748b;">/ Night</small></div>
          </div>

          <a href="/checkout?room=<%= room.slug || room.id %>" class="btn-blue pulsing-btn" style="width: 100%; padding: 14px 20px; font-size: 15px; font-weight: bold; text-align: center; display: block; border-radius: 8px; margin-bottom: 15px;">
            <i class="fas fa-calendar-check"></i> Book Now & Confirm Stay
          </a>

          <div style="text-align: center; font-size: 13px; color: #64748b; margin-bottom: 20px;">
            <i class="fas fa-shield-halved" style="color: #22c55e;"></i> Best Price Guaranteed • Instant Confirmation
          </div>

          <div style="background: #f8fafc; padding: 18px; border-radius: 10px; border: 1px solid #e2e8f0; text-align: center;">
            <span style="font-size: 12px; color: #64748b; display: block; margin-bottom: 6px;">Need Assistance or Custom Requests?</span>
            <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20enquire%20about%20booking%20the%20<%= encodeURIComponent(room.name) %>." target="_blank" style="color: #25d366; font-weight: bold; font-size: 14px; text-decoration: none;">
              <i class="fab fa-whatsapp"></i> Chat with Front Desk Concierge
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<%- include('partials/footer') %>
