<%- include('partials/header') %>

<!-- Privacy Policy Hero Banner -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.82), rgba(15, 23, 42, 0.85)), url('/images/hotel-img-1.jpg');">
  <div class="container" style="max-width: 900px;">
    <h1 style="font-size: 42px; margin-bottom: 10px; color: #ffffff;">Privacy Policy</h1>
    <p style="color: #cbd5e1; font-size: 16px; line-height: 1.6;">How Flutter Hotels & Resorts protects and handles your personal information.</p>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container" style="max-width: 900px;">
    
    <div style="background: #ffffff; padding: 45px; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 6px 25px rgba(0,0,0,0.04); color: #334155; line-height: 1.8;">
      <p style="font-size: 15.5px; margin-bottom: 25px;">
        This privacy policy sets out how Flutter Hotels & Resorts uses and protects any information that the guest gives us when using this website.
      </p>

      <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 30px;">
        <div style="display: flex; gap: 15px; align-items: flex-start;">
          <span style="width: 32px; height: 32px; background: rgba(95, 134, 193, 0.15); color: var(--primary-blue); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; flex-shrink: 0;">1</span>
          <p style="margin: 0; font-size: 15px; color: #475569;">
            We are committed to ensuring that the guest's privacy is protected. Should we ask the visitor/guest to provide certain information by which they can be identified when using this website, then the visitor/guest can be assured that it will only be used in accordance with this privacy strategy.
          </p>
        </div>

        <div style="display: flex; gap: 15px; align-items: flex-start;">
          <span style="width: 32px; height: 32px; background: rgba(95, 134, 193, 0.15); color: var(--primary-blue); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; flex-shrink: 0;">2</span>
          <p style="margin: 0; font-size: 15px; color: #475569;">
            We at Flutter Hotels & Resorts are committed to the privacy of everyone who accesses our website <strong>flutterhotel.com</strong> and only collect personal data about the visitor/guest as needed to provide them with outstanding service, and to help process their request or provide them with information.
          </p>
        </div>
      </div>

      <div style="background: #f1f5f9; padding: 20px 25px; border-radius: 12px; border-left: 4px solid var(--primary-blue);">
        <h4 style="margin: 0 0 6px; color: var(--dark-bg); font-size: 16px;">Contact Support</h4>
        <p style="margin: 0; font-size: 14px; color: #475569;">
          If you have any questions regarding our Privacy Policy or data protection practices, please reach us at:<br>
          Phone: <a href="tel:+918929232740" style="color: var(--primary-blue); font-weight: bold;">+91 89 2923 2740</a> | Email: <a href="mailto:sales@flutterhotel.com" style="color: var(--primary-blue); font-weight: bold;">sales@flutterhotel.com</a>
        </p>
      </div>

    </div>

  </div>
</section>

<%- include('partials/footer') %>
