<%- include('partials/header') %>

<!-- Meetings & Events Hero Banner (User's New Meeting Venue Banner Image) -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.82), rgba(15, 23, 42, 0.85)), url('/images/meeting-hall-hero.webp');">
  <div class="container" style="max-width: 900px; position: relative; z-index: 2;">
    <span style="background: rgba(245, 158, 11, 0.25); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 6px 20px; border-radius: 30px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: inline-block; margin-bottom: 18px; backdrop-filter: blur(4px);">
      <i class="fas fa-handshake"></i> MICE & Corporate Offsites
    </span>
    <h1 style="font-size: 44px; margin-bottom: 14px; color: #ffffff; font-family: 'Cinzel', serif; line-height: 1.25;">Inspiring Corporate Retreats & Executive Offsites</h1>
    <p style="color: #cbd5e1; font-size: 16.5px; line-height: 1.7; max-width: 760px; margin: 0 auto 25px;">
      Step away from office distractions. Align your team, drive strategic breakthroughs, and foster deep connection amidst the peaceful Garhwal Himalayas at Flutter Hotels & Resorts, Lansdowne.
    </p>
    <a href="#eventEnquirySection" class="btn-blue pulsing-btn" style="padding: 14px 32px; font-size: 15px; font-weight: bold;">
      <i class="fas fa-paper-plane"></i> Request Custom Corporate Proposal
    </a>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    
    <div style="text-align: center; max-width: 750px; margin: 0 auto 50px;">
      <span class="section-subtitle">Venue Spaces</span>
      <h2 class="section-title">Designed for Alignment, Focus & Productivity</h2>
      <p style="color: #64748b; font-size: 15px;">
        Whether you are planning a high-level leadership summit, annual strategy retreat, or team bonding getaway, our versatile venue spaces balance formal productivity with mountain serenity.
      </p>
    </div>

    <!-- Feature Cards with Real Meeting Venue Photos -->
    <div style="display: flex; flex-direction: column; gap: 40px; margin-bottom: 60px;">
      
      <!-- Feature 1: Executive Plenary Hall -->
      <div style="background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; display: grid; grid-template-columns: 1fr 1.2fr;" class="responsive-two-col">
        <div style="height: 100%; min-height: 320px; position: relative;">
          <img src="/images/conference-setup-1.webp" alt="Executive Conference Hall Lansdowne" style="width: 100%; height: 100%; object-fit: cover;">
          <span style="position: absolute; top: 15px; left: 15px; background: var(--primary-blue); color: #fff; padding: 5px 16px; border-radius: 20px; font-size: 12px; font-weight: bold;">
            <i class="fas fa-building"></i> Plenary Conference Hall
          </span>
        </div>
        <div style="padding: 35px; display: flex; flex-direction: column; justify-content: center;">
          <div style="display: flex; gap: 15px; font-size: 13px; color: #0284c7; font-weight: bold; margin-bottom: 8px;">
            <span><i class="fas fa-users"></i> Up to 80 Delegates</span>
            <span><i class="fas fa-wifi"></i> High-Speed Fiber Internet</span>
          </div>
          <h3 style="font-size: 24px; color: var(--dark-bg); margin-bottom: 12px;">1. Executive Conference & Plenary Hall</h3>
          <p style="color: #475569; font-size: 14.5px; line-height: 1.7; margin-bottom: 18px;">
            A state-of-the-art conference venue designed for high-impact presentations, town halls, and strategy sessions. Flexible configurations available: Theater, U-Shape, Classroom, or Boardroom layouts.
          </p>
          
          <ul style="list-style: none; padding: 0; margin: 0 0 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px;" class="responsive-two-col">
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> HD Projection & Audio Systems
            </li>
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> Wireless Mics & Podium Setup
            </li>
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> Ergonomic Seating & Writing Pads
            </li>
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> Flipcharts & Whiteboards
            </li>
          </ul>

          <div>
            <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20check%20availability%20for%20the%20Executive%20Conference%20Hall." target="_blank" class="btn-outline-blue" style="padding: 10px 22px; font-size: 13px;">
              <i class="fab fa-whatsapp"></i> Check Hall Availability
            </a>
          </div>
        </div>
      </div>

      <!-- Feature 2: Breakout & Strategy Sprints -->
      <div style="background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; display: grid; grid-template-columns: 1.2fr 1fr;" class="responsive-two-col">
        <div style="padding: 35px; display: flex; flex-direction: column; justify-content: center; order: 1;" class="order-mobile-2">
          <div style="display: flex; gap: 15px; font-size: 13px; color: #0284c7; font-weight: bold; margin-bottom: 8px;">
            <span><i class="fas fa-comments"></i> Breakout Sessions</span>
            <span><i class="fas fa-lightbulb"></i> Small Group Ideation</span>
          </div>
          <h3 style="font-size: 24px; color: var(--dark-bg); margin-bottom: 12px;">2. Breakout Rooms & Strategy Workshops</h3>
          <p style="color: #475569; font-size: 14.5px; line-height: 1.7; margin-bottom: 18px;">
            Dedicated breakout spaces ideal for department alignment, smaller group workshops, leadership roundtables, and creative brainstorming sessions without interferences.
          </p>

          <ul style="list-style: none; padding: 0; margin: 0 0 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px;" class="responsive-two-col">
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> Quiet & Distraction-Free
            </li>
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> High-Speed Wi-Fi Zone
            </li>
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> Coffee & Cookie Refills
            </li>
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> Natural Light Ambience
            </li>
          </ul>

          <div>
            <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20know%20more%20about%20Breakout%20Meeting%20Spaces." target="_blank" class="btn-outline-blue" style="padding: 10px 22px; font-size: 13px;">
              <i class="fab fa-whatsapp"></i> Plan Breakout Sessions
            </a>
          </div>
        </div>
        <div style="height: 100%; min-height: 320px; position: relative; order: 2;" class="order-mobile-1">
          <img src="/images/conference-setup-2.webp" alt="Breakout Meeting Space Lansdowne" style="width: 100%; height: 100%; object-fit: cover;">
          <span style="position: absolute; top: 15px; right: 15px; background: #0284c7; color: #fff; padding: 5px 16px; border-radius: 20px; font-size: 12px; font-weight: bold;">
            <i class="fas fa-brain"></i> Strategy Space
          </span>
        </div>
      </div>

      <!-- Feature 3: Mountain Lawns for Team Building -->
      <div style="background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; display: grid; grid-template-columns: 1fr 1.2fr;" class="responsive-two-col">
        <div style="height: 100%; min-height: 320px; position: relative;">
          <img src="/images/resort-lawns-garden.avif" alt="Outdoor Resort Lawns Lansdowne" style="width: 100%; height: 100%; object-fit: cover;">
          <span style="position: absolute; top: 15px; left: 15px; background: #22c55e; color: #fff; padding: 5px 16px; border-radius: 20px; font-size: 12px; font-weight: bold;">
            <i class="fas fa-tree"></i> Outdoor Mountain Lawns
          </span>
        </div>
        <div style="padding: 35px; display: flex; flex-direction: column; justify-content: center;">
          <div style="display: flex; gap: 15px; font-size: 13px; color: #0284c7; font-weight: bold; margin-bottom: 8px;">
            <span><i class="fas fa-campground"></i> Open-Air Greenery</span>
            <span><i class="fas fa-users"></i> Up to 150 Guests</span>
          </div>
          <h3 style="font-size: 24px; color: var(--dark-bg); margin-bottom: 12px;">3. Outdoor Lawns for Team-Building & Wellness</h3>
          <p style="color: #475569; font-size: 14.5px; line-height: 1.7; margin-bottom: 18px;">
            Foster genuine camaraderie and team energy with outdoor interactive games, morning hill yoga, sunset networking drinks, and evening bonfire DJ sessions under the star-lit sky.
          </p>

          <ul style="list-style: none; padding: 0; margin: 0 0 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px;" class="responsive-two-col">
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> Outdoor Team Challenges
            </li>
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> Bonfire & DJ Evening Setup
            </li>
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> Live Barbecue Grills
            </li>
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> Guided Hillside Walks
            </li>
          </ul>

          <div>
            <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20plan%20Outdoor%20Team%20Building%20activities." target="_blank" class="btn-outline-blue" style="padding: 10px 22px; font-size: 13px;">
              <i class="fab fa-whatsapp"></i> Plan Team Activities
            </a>
          </div>
        </div>
      </div>

      <!-- Feature 4: Corporate Dining & Gala Receptions -->
      <div style="background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; display: grid; grid-template-columns: 1.2fr 1fr;" class="responsive-two-col">
        <div style="padding: 35px; display: flex; flex-direction: column; justify-content: center; order: 1;" class="order-mobile-2">
          <div style="display: flex; gap: 15px; font-size: 13px; color: #0284c7; font-weight: bold; margin-bottom: 8px;">
            <span><i class="fas fa-utensils"></i> All-Day Catering</span>
            <span><i class="fas fa-wine-glass-sparkles"></i> Gala Dinners</span>
          </div>
          <h3 style="font-size: 24px; color: var(--dark-bg); margin-bottom: 12px;">4. Custom Corporate Dining & Gala Dinners</h3>
          <p style="color: #475569; font-size: 14.5px; line-height: 1.7; margin-bottom: 18px;">
            Keep your team energized with chef-curated culinary spreads — power breakfast buffets, working lunch spreads, high-tea with cookies, and multi-course celebratory gala dinners.
          </p>

          <ul style="list-style: none; padding: 0; margin: 0 0 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px;" class="responsive-two-col">
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> Customized Multi-Cuisine Buffets
            </li>
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> Garhwali & North Indian Delicacies
            </li>
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> High-Tea Snacks & Beverages
            </li>
            <li style="font-size: 13.5px; color: #334155; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-check-circle" style="color: #22c55e;"></i> Custom Dietary Accommodations
            </li>
          </ul>

          <div>
            <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20discuss%20Corporate%20Catering%20menus." target="_blank" class="btn-outline-blue" style="padding: 10px 22px; font-size: 13px;">
              <i class="fab fa-whatsapp"></i> Discuss Dining Menus
            </a>
          </div>
        </div>
        <div style="height: 100%; min-height: 320px; position: relative; order: 2;" class="order-mobile-1">
          <img src="/images/meeting-banquet-space.webp" alt="Corporate Banquet Dining Lansdowne" style="width: 100%; height: 100%; object-fit: cover;">
          <span style="position: absolute; top: 15px; right: 15px; background: #f59e0b; color: #0f172a; padding: 5px 16px; border-radius: 20px; font-size: 12px; font-weight: bold;">
            <i class="fas fa-plate-wheat"></i> Banquet Dining
          </span>
        </div>
      </div>

    </div>

    <!-- Curated Corporate Inclusions Grid -->
    <div style="margin-bottom: 60px;">
      <div style="text-align: center; margin-bottom: 35px;">
        <span class="section-subtitle">Turnkey Support</span>
        <h2 class="section-title">Curated Corporate Inclusions</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px;">
        <div style="background: #ffffff; padding: 30px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
          <i class="fas fa-user-tie" style="font-size: 32px; color: var(--primary-blue); margin-bottom: 12px;"></i>
          <h4 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Dedicated Event Lead</h4>
          <p style="color: #64748b; font-size: 14px; margin: 0; line-height: 1.6;">On-site dedicated event coordinator to manage timelines, setups, and delegate needs.</p>
        </div>

        <div style="background: #ffffff; padding: 30px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
          <i class="fas fa-bus-simple" style="font-size: 32px; color: #0284c7; margin-bottom: 12px;"></i>
          <h4 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Group Transportation</h4>
          <p style="color: #64748b; font-size: 14px; margin: 0; line-height: 1.6;">Coordinated AC Volvo & Tempo Traveller transfers from Delhi, Noida, Meerut & Dehradun.</p>
        </div>

        <div style="background: #ffffff; padding: 30px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
          <i class="fas fa-file-invoice-dollar" style="font-size: 32px; color: #22c55e; margin-bottom: 12px;"></i>
          <h4 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Bundled Transparent Pricing</h4>
          <p style="color: #64748b; font-size: 14px; margin: 0; line-height: 1.6;">All-inclusive per-delegate packages covering stay, meals, conference hall & activities without hidden fees.</p>
        </div>

        <div style="background: #ffffff; padding: 30px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
          <i class="fas fa-compass" style="font-size: 32px; color: #f59e0b; margin-bottom: 12px;"></i>
          <h4 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Guided Sightseeing Treks</h4>
          <p style="color: #64748b; font-size: 14px; margin: 0; line-height: 1.6;">Optional half-day team excursions to Tip-n-Top, Bhulla Lake, and Tarkeshwar Mahadev.</p>
        </div>
      </div>
    </div>

    <!-- Quick Corporate Enquiry Form -->
    <div id="eventEnquirySection" style="background: #ffffff; max-width: 850px; margin: 0 auto; padding: 45px; border-radius: 16px; border: 1.5px solid #e2e8f0; box-shadow: 0 10px 35px rgba(0,0,0,0.06);">
      <h3 style="font-size: 26px; color: var(--dark-bg); text-align: center; margin-bottom: 10px; font-family: 'Cinzel', serif;">Plan Your Corporate Retreat With Us</h3>
      <p style="color: #64748b; text-align: center; font-size: 15px; margin-bottom: 30px;">
        Fill in your company & event details below. Our corporate MICE specialist will contact you with a customized package proposal within 2 hours.
      </p>

      <form action="/contact" method="POST" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;" class="responsive-two-col">
        <div>
          <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Company / Group Name *</label>
          <input type="text" name="name" required placeholder="e.g. Acme Tech / Corporate Team" class="form-control-custom">
        </div>
        <div>
          <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Mobile Number *</label>
          <input type="tel" name="phone" required placeholder="+91 98765 43210" class="form-control-custom">
        </div>
        <div>
          <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Expected Attendees *</label>
          <input type="number" name="guests" value="30" class="form-control-custom">
        </div>
        <div>
          <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Proposed Event Dates</label>
          <input type="date" name="eventDate" class="form-control-custom">
        </div>
        <div style="grid-column: 1 / -1;">
          <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Event Requirements & Special Notes</label>
          <textarea name="message" rows="3" placeholder="Tell us about conference hall setup, room count, meals, bonfire, AC Tempo Traveller transport requirements..." class="form-control-custom"></textarea>
        </div>
        <div style="grid-column: 1 / -1; text-align: center; margin-top: 10px;">
          <button type="submit" class="btn-blue pulsing-btn" style="padding: 14px 40px; font-size: 15px; font-weight: bold;"><i class="fas fa-paper-plane"></i> Submit Corporate Inquiry</button>
        </div>
      </form>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
