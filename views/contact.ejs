<%- include('partials/header') %>

<div style="background: linear-gradient(rgba(26, 38, 56, 0.75), rgba(26, 38, 56, 0.75)), url('/images/hero-banner.jpg') center/cover; padding: 70px 0; text-align: center; color: #fff;">
  <div class="container">
    <h1 style="font-size: 42px; margin-bottom: 10px; color: #ffffff;">Contact Us</h1>
    <p style="color: var(--primary-blue); letter-spacing: 2px; text-transform: uppercase; font-weight: 600;">We Are Here To Assist You 24/7</p>
  </div>
</div>

<section class="section-padding">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px;">
      
      <!-- Contact Info -->
      <div>
        <span class="section-subtitle" style="text-align: left;">Get In Touch</span>
        <h2 class="section-title" style="text-align: left;">Reach Out To Hotux Concierge</h2>
        <p style="color: var(--text-muted); margin-bottom: 30px;">
          Have questions about suite reservations, private events, or airport transfers? Fill out the form or reach out to our team directly.
        </p>

        <% if (success) { %>
          <div style="background: #e0f2fe; color: #0284c7; padding: 15px; border-radius: 6px; margin-bottom: 20px; font-weight: 500;">
            <i class="fas fa-check-circle"></i> <%= success %>
          </div>
        <% } %>

        <div style="display: flex; gap: 20px; margin-bottom: 25px;">
          <div style="width: 50px; height: 50px; background: rgba(95, 134, 193, 0.15); color: var(--primary-blue); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
            <i class="fas fa-map-marker-alt"></i>
          </div>
          <div>
            <h4 style="font-size: 18px; margin-bottom: 4px;">Hotel Address</h4>
            <p style="color: var(--text-muted); font-size: 14px;">445 Mount Eden Road, Sundarbasti, Chakrapath</p>
          </div>
        </div>

        <div style="display: flex; gap: 20px; margin-bottom: 25px;">
          <div style="width: 50px; height: 50px; background: rgba(95, 134, 193, 0.15); color: var(--primary-blue); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
            <i class="fas fa-phone-alt"></i>
          </div>
          <div>
            <h4 style="font-size: 18px; margin-bottom: 4px;">Phone & Reservations</h4>
            <p style="color: var(--text-muted); font-size: 14px;">+977 222-444-6666 / +977 222-333-444</p>
          </div>
        </div>

        <div style="display: flex; gap: 20px;">
          <div style="width: 50px; height: 50px; background: rgba(95, 134, 193, 0.15); color: var(--primary-blue); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
            <i class="fas fa-envelope"></i>
          </div>
          <div>
            <h4 style="font-size: 18px; margin-bottom: 4px;">Email Contact</h4>
            <p style="color: var(--text-muted); font-size: 14px;">info@hotuxhotel.com / reservations@hotuxhotel.com</p>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div style="background: var(--light-bg); padding: 35px; border-radius: 10px; border: 1.5px solid #e2e8f0;">
        <h3 style="font-size: 22px; margin-bottom: 20px;">Send Us A Message</h3>
        
        <form action="/contact" method="POST">
          <div class="form-group-custom" style="margin-bottom: 15px;">
            <label>Your Name *</label>
            <input type="text" name="name" required placeholder="John Doe" class="form-control-custom">
          </div>

          <div class="form-group-custom" style="margin-bottom: 15px;">
            <label>Your Email *</label>
            <input type="email" name="email" required placeholder="john@example.com" class="form-control-custom">
          </div>

          <div class="form-group-custom" style="margin-bottom: 15px;">
            <label>Phone Number</label>
            <input type="tel" name="phone" placeholder="+1 234 567 890" class="form-control-custom">
          </div>

          <div class="form-group-custom" style="margin-bottom: 15px;">
            <label>Subject</label>
            <input type="text" name="subject" placeholder="Suite inquiry / Event booking" class="form-control-custom">
          </div>

          <div class="form-group-custom" style="margin-bottom: 20px;">
            <label>Message *</label>
            <textarea name="message" rows="5" required placeholder="How can we assist you today?" class="form-control-custom"></textarea>
          </div>

          <button type="submit" class="btn-blue" style="width: 100%; padding: 14px; border: none;"><i class="fas fa-paper-plane"></i> Send Message</button>
        </form>
      </div>

    </div>
  </div>
</section>

<%- include('partials/footer') %>
