<%- include('partials/header') %>

<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.55), rgba(15, 23, 42, 0.72)), url('/images/contact-hero-banner.jpg'); background-size: cover; background-position: center 35%;">
  <div class="container" style="max-width: 900px;">
    <h1 style="font-size: 42px; margin-bottom: 12px; color: #ffffff;">Get in Touch With Flutter Hotels & Resorts</h1>
    <p style="color: #cbd5e1; font-size: 16px; line-height: 1.6;">
      Questions about your stay, a group trip, or an event? We usually respond fastest on WhatsApp or by phone.
    </p>
  </div>
</div>

<section class="section-padding">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px;" class="responsive-two-col">
      
      <!-- Contact Info -->
      <div>
        <span class="section-subtitle" style="text-align: left;">Contact Details</span>
        <h2 class="section-title" style="text-align: left;">We Are Here To Assist You</h2>
        <p style="color: var(--text-muted); margin-bottom: 30px;">
          Reach us directly using the details below, or fill in the enquiry form and our reservations team will get back to you immediately.
        </p>

        <% if (typeof success !== 'undefined' && success) { %>
          <div style="background: #e0f2fe; color: #0284c7; padding: 15px; border-radius: 8px; margin-bottom: 25px; font-weight: 500; border: 1px solid #bae6fd;">
            <i class="fas fa-check-circle"></i> <%= success %>
          </div>
        <% } %>

        <div style="display: flex; gap: 20px; margin-bottom: 25px;">
          <div style="width: 50px; height: 50px; background: rgba(95, 134, 193, 0.15); color: var(--primary-blue); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
            <i class="fas fa-map-marker-alt"></i>
          </div>
          <div>
            <h4 style="font-size: 18px; margin-bottom: 4px; color: var(--dark-bg);">Property Address</h4>
            <p style="color: var(--text-muted); font-size: 14px;">Palkot–Lansdowne, Pauri Garhwal, Uttarakhand – 246155, India</p>
          </div>
        </div>

        <div style="display: flex; gap: 20px; margin-bottom: 25px;">
          <div style="width: 50px; height: 50px; background: rgba(95, 134, 193, 0.15); color: var(--primary-blue); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
            <i class="fas fa-phone-alt"></i>
          </div>
          <div>
            <h4 style="font-size: 18px; margin-bottom: 4px; color: var(--dark-bg);">Phone & Reservations</h4>
            <p style="color: var(--text-muted); font-size: 14px;">
              Primary: <a href="tel:+918929232740" style="color: var(--primary-blue); font-weight: bold;">+91 89 2923 2740</a>
            </p>
          </div>
        </div>

        <div style="display: flex; gap: 20px; margin-bottom: 25px;">
          <div style="width: 50px; height: 50px; background: rgba(95, 134, 193, 0.15); color: var(--primary-blue); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
            <i class="fas fa-envelope"></i>
          </div>
          <div>
            <h4 style="font-size: 18px; margin-bottom: 4px; color: var(--dark-bg);">Email Reservations</h4>
            <p style="color: var(--text-muted); font-size: 14px;">sales@flutterhotel.com</p>
          </div>
        </div>

        <div style="display: flex; gap: 20px; margin-bottom: 30px;">
          <div style="width: 50px; height: 50px; background: rgba(95, 134, 193, 0.15); color: var(--primary-blue); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
            <i class="far fa-clock"></i>
          </div>
          <div>
            <h4 style="font-size: 18px; margin-bottom: 6px; color: var(--dark-bg);">Check-in & Check-out</h4>
            <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 3px;"><i class="fas fa-sign-in-alt" style="color: var(--primary-blue); margin-right: 6px;"></i> Check-in: <strong>12:00 PM</strong></p>
            <p style="color: var(--text-muted); font-size: 14px; margin: 0;"><i class="fas fa-sign-out-alt" style="color: var(--primary-blue); margin-right: 6px;"></i> Check-out: <strong>10:00 AM</strong></p>
          </div>
        </div>

        <div style="display: flex; gap: 15px; margin-top: 20px; flex-wrap: wrap;">
          <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I’d%20like%20to%20know%20more%20about%20Flutter%20Hotels%20%26%20Resorts." target="_blank" class="btn-blue" style="background: #25d366 !important; border-color: #25d366 !important; padding: 12px 24px;">
            <i class="fab fa-whatsapp"></i> Chat on WhatsApp
          </a>
          <a href="tel:<%= phoneMain.replace(/\s+/g, '') %>" class="btn-outline-blue" style="padding: 12px 24px;">
            <i class="fas fa-phone-alt"></i> Call Now
          </a>
        </div>
      </div>

      <!-- Contact Form -->
      <div style="background: var(--light-bg); padding: 30px; border-radius: 16px; border: 1.5px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
        <h3 style="font-size: 22px; margin-bottom: 20px; color: var(--dark-bg); font-family: 'Cinzel', serif;">Send Us an Enquiry</h3>
        
        <form action="/contact" method="POST">
          <div class="form-group-custom" style="margin-bottom: 15px;">
            <label style="font-size: 13px; font-weight: 600; color: #334155;">Full Name *</label>
            <input type="text" name="name" required placeholder="John Doe" class="form-control-custom">
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;" class="responsive-two-col">
            <div>
              <label style="font-size: 13px; font-weight: 600; color: #334155;">Phone Number *</label>
              <input type="tel" name="phone" required placeholder="+91 89 2923 2740" class="form-control-custom">
            </div>
            <div>
              <label style="font-size: 13px; font-weight: 600; color: #334155;">Email Address *</label>
              <input type="email" name="email" required placeholder="john@example.com" class="form-control-custom">
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;" class="responsive-two-col">
            <div>
              <label style="font-size: 13px; font-weight: 600; color: #334155;">Check-in / Check-out Dates</label>
              <input type="text" name="dates" placeholder="e.g. 20-22 Aug" class="form-control-custom">
            </div>
            <div>
              <label style="font-size: 13px; font-weight: 600; color: #334155;">Number of Guests</label>
              <input type="text" name="guests" placeholder="e.g. 2 Adults" class="form-control-custom">
            </div>
          </div>

          <div class="form-group-custom" style="margin-bottom: 15px;">
            <label style="font-size: 13px; font-weight: 600; color: #334155;">Purpose of Enquiry</label>
            <select name="subject" class="form-control-custom">
              <option value="Room Booking">Room Booking</option>
              <option value="Weekday / Weekend Offer">Weekday / Weekend Offer</option>
              <option value="2N/3D Group Departure">2N/3D Group Departure</option>
              <option value="Honeymoon Package">Honeymoon Package</option>
              <option value="Corporate / MICE Event">Corporate / MICE Event</option>
              <option value="Wedding & Celebration">Wedding & Celebration</option>
              <option value="Dining / Restaurant Enquiry">Dining / Restaurant Enquiry</option>
            </select>
          </div>

          <div class="form-group-custom" style="margin-bottom: 20px;">
            <label style="font-size: 13px; font-weight: 600; color: #334155;">Message / Notes</label>
            <textarea name="message" rows="4" placeholder="How can we assist you today?" class="form-control-custom"></textarea>
          </div>

          <button type="submit" class="btn-blue" style="width: 100%; padding: 14px; border: none; font-size: 15px; font-weight: bold;"><i class="fas fa-paper-plane"></i> Send Enquiry</button>
        </form>
      </div>

    </div>

    <!-- Google Business Profile Location Map Section -->
    <div style="margin-top: 60px; text-align: center;">
      <span class="section-subtitle">Location & Directions</span>
      <h2 class="section-title">Find Us On Google Maps</h2>
      <p style="color: var(--text-muted); margin-bottom: 25px;">
        Palkot–Lansdowne, Pauri Garhwal, Uttarakhand – 246155, India
      </p>

      <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.1); border: 2px solid #e2e8f0; height: 420px; position: relative;">
        <iframe 
          src="https://maps.google.com/maps?q=Flutter+Hotels+%26+Resort+Pvt+Ltd+Lansdowne+Uttarakhand&t=&z=15&ie=UTF8&iwloc=&output=embed" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy">
        </iframe>
      </div>

      <div style="margin-top: 20px;">
        <a href="https://share.google/zTrQmg3ZsRlLWlJuk" target="_blank" class="btn-blue" style="font-size: 14px; padding: 12px 30px;">
          <i class="fas fa-map-marked-alt"></i> Open Google Business Profile Location & Navigation
        </a>
      </div>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
