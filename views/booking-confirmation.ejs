<%- include('partials/header') %>

<section class="section-padding" style="background: #f8fafc; min-height: 80vh; padding: 60px 0;">
  <div class="container" style="max-width: 820px;">
    
    <!-- Success Badge Banner -->
    <div style="background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 35px rgba(0,0,0,0.08); border: 1px solid #e2e8f0;">
      
      <div style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 40px 30px; text-align: center; color: #ffffff; position: relative;">
        <div style="width: 75px; height: 75px; background: linear-gradient(135deg, #22c55e 0%, #15803d 100%); color: #ffffff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 36px; margin: 0 auto 18px; box-shadow: 0 8px 25px rgba(34, 197, 94, 0.4);">
          <i class="fas fa-check"></i>
        </div>

        <span style="background: rgba(255, 255, 255, 0.12); color: #f59e0b; padding: 5px 18px; border-radius: 20px; font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; border: 1px solid rgba(255, 255, 255, 0.2);">
          Booking Confirmed
        </span>

        <h1 style="font-size: 32px; color: #ffffff; margin: 15px 0 8px; font-family: 'Cinzel', serif;">Thank You, <%= booking.guestName %>!</h1>
        <p style="color: #cbd5e1; font-size: 15px; max-width: 600px; margin: 0 auto; line-height: 1.6;">
          Your reservation at <strong>Flutter Hotels & Resorts, Lansdowne</strong> has been registered. An official email receipt has been dispatched to <strong><%= booking.email %></strong>.
        </p>
      </div>

      <!-- Luxury Booking Ticket Pass Card -->
      <div style="padding: 35px;">
        
        <!-- Ticket Header / Barcode style -->
        <div style="background: #f1f5f9; padding: 18px 25px; border-radius: 10px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border: 1px solid #e2e8f0;">
          <div>
            <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; letter-spacing: 1px;">Booking Reference ID</span>
            <div style="font-size: 22px; font-weight: bold; color: var(--primary-blue); font-family: monospace; letter-spacing: 1px;"><%= booking.id %></div>
          </div>
          <div style="text-align: right;">
            <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700;">Status</span>
            <div><span style="background: #dcfce7; color: #166534; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: bold;">Confirmed</span></div>
          </div>
        </div>

        <!-- Room Thumbnail Banner if Room Object Exists -->
        <% if (typeof room !== 'undefined' && room) { %>
          <div style="display: flex; gap: 20px; background: #ffffff; padding: 15px; border-radius: 10px; border: 1px solid #e2e8f0; margin-bottom: 25px; align-items: center;">
            <img src="<%= room.image %>" alt="<%= room.name %>" style="width: 110px; height: 80px; object-fit: cover; border-radius: 8px;">
            <div>
              <h4 style="font-size: 17px; color: var(--dark-bg); margin-bottom: 4px;"><%= room.name %></h4>
              <p style="color: #64748b; font-size: 13px; margin: 0;"><i class="fas fa-bed" style="color: var(--primary-blue);"></i> <%= room.bed %> | <i class="fas fa-mountain" style="color: var(--primary-blue);"></i> <%= room.view %></p>
            </div>
          </div>
        <% } %>

        <!-- Detailed Breakdown Grid -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">
          
          <div style="background: #f8fafc; padding: 18px; border-radius: 10px; border: 1px solid #f1f5f9;">
            <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700;">Check-in Date & Time</span>
            <div style="font-size: 16px; font-weight: bold; color: var(--dark-bg); margin-top: 4px;">
              <i class="fas fa-sign-in-alt" style="color: var(--primary-blue); margin-right: 6px;"></i> <%= booking.checkIn %>
            </div>
            <span style="font-size: 12px; color: #64748b;">Check-in starts from 12:00 PM</span>
          </div>

          <div style="background: #f8fafc; padding: 18px; border-radius: 10px; border: 1px solid #f1f5f9;">
            <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700;">Check-out Date & Time</span>
            <div style="font-size: 16px; font-weight: bold; color: var(--dark-bg); margin-top: 4px;">
              <i class="fas fa-sign-out-alt" style="color: var(--primary-blue); margin-right: 6px;"></i> <%= booking.checkOut %>
            </div>
            <span style="font-size: 12px; color: #64748b;">Check-out by 10:00 AM</span>
          </div>

        </div>

        <!-- Guest Details & Payment Table -->
        <div style="background: #ffffff; border-radius: 10px; border: 1px solid #e2e8f0; padding: 20px; margin-bottom: 30px;">
          <div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
            <span style="color: #64748b; font-size: 14px;">Primary Guest:</span>
            <strong style="color: var(--dark-bg); font-size: 14px;"><%= booking.guestName %></strong>
          </div>
          <div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
            <span style="color: #64748b; font-size: 14px;">Contact Email:</span>
            <strong style="color: var(--dark-bg); font-size: 14px;"><%= booking.email %></strong>
          </div>
          <div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
            <span style="color: #64748b; font-size: 14px;">Contact Phone:</span>
            <strong style="color: var(--dark-bg); font-size: 14px;"><%= booking.phone || 'N/A' %></strong>
          </div>
          <div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
            <span style="color: #64748b; font-size: 14px;">Number of Guests:</span>
            <strong style="color: var(--dark-bg); font-size: 14px;"><%= booking.guests %> Guest(s)</strong>
          </div>
          <div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
            <span style="color: #64748b; font-size: 14px;">Payment Method:</span>
            <strong style="color: var(--dark-bg); font-size: 14px;"><%= booking.paymentMethod || 'Pay at Hotel Check-in' %></strong>
          </div>
          <div style="display: flex; justify-content: space-between; padding-top: 15px; margin-top: 5px; font-size: 18px; font-weight: bold;">
            <span>Total Payable Amount:</span>
            <span style="color: var(--primary-blue); font-size: 24px;">₹<%= booking.totalPrice %></span>
          </div>
        </div>

        <!-- Check-in Guidance Box -->
        <div style="background: #f0f9ff; border-left: 4px solid var(--primary-blue); padding: 18px; border-radius: 8px; margin-bottom: 30px; font-size: 13.5px; color: #0369a1; line-height: 1.6;">
          <i class="fas fa-info-circle"></i> <strong>Important Check-in Instructions:</strong> Please present a government-issued Photo ID (Aadhaar, Driving License, Voter ID, or Passport) for all adult guests at the front desk upon check-in.
        </div>

        <!-- Action Buttons -->
        <div style="display: flex; gap: 15px; flex-wrap: wrap; justify-content: center;">
          <button onclick="window.print()" class="btn-blue" style="padding: 12px 26px;">
            <i class="fas fa-print"></i> Download / Print Receipt
          </button>
          <a href="https://wa.me/918929232740?text=Hi,%20I%20have%20a%20question%20regarding%20Booking%20ID%20<%= booking.id %>" target="_blank" class="btn-blue" style="background: #25d366 !important; border-color: #25d366 !important; padding: 12px 24px;">
            <i class="fab fa-whatsapp"></i> Chat With Concierge
          </a>
          <a href="/" class="btn-outline-blue" style="padding: 12px 24px;">
            <i class="fas fa-home"></i> Back to Homepage
          </a>
        </div>

      </div>

    </div>

  </div>
</section>

<%- include('partials/footer') %>
