<%- include('partials/header') %>

<!-- Dining Hero Banner (New Full-Height Mobile Responsive Banner) -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.85)), url('/images/dining-hero-banner.webp');">
  <div class="container" style="max-width: 900px; position: relative; z-index: 2;">
    <span style="background: rgba(245, 158, 11, 0.25); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 6px 20px; border-radius: 30px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: inline-block; margin-bottom: 18px; backdrop-filter: blur(4px);">
      <i class="fas fa-utensils"></i> Indian Multi-Cuisine Restaurant
    </span>
    <h1 style="font-size: 44px; margin-bottom: 14px; color: #ffffff; font-family: 'Cinzel', serif; line-height: 1.25;">Dining at Flutter Hotels & Resorts</h1>
    <p style="color: #cbd5e1; font-size: 16.5px; line-height: 1.7; max-width: 760px; margin: 0 auto 25px;">
      Discover an authentic Indian dining experience that seamlessly blends culinary artistry with valley views. Serving freshly prepared Garhwali delicacies, North Indian classics, and South Indian breakfast specials.
    </p>
    <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20reserve%20a%20table%20/%20enquire%20about%20dining%20at%20Flutter%20Hotels." target="_blank" class="btn-blue pulsing-btn" style="padding: 14px 32px; font-size: 15px; font-weight: bold;">
      <i class="fab fa-whatsapp"></i> Reserve Table / Order Dining
    </a>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    
    <!-- Overview Grid -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; margin-bottom: 60px;" class="responsive-two-col">
      <div>
        <span class="section-subtitle" style="text-align: left;">Savour Every Moment</span>
        <h2 class="section-title" style="text-align: left; font-size: 34px;">Culinary Artistry Meets Valley Views</h2>
        <p style="color: #475569; font-size: 15px; line-height: 1.8; margin-bottom: 20px;">
          Nestled amidst the serene pine forests of Lansdowne, our restaurant at <strong>Flutter Hotels & Resorts</strong> offers an unforgettable gastronomic journey. Featuring large floor-to-ceiling glass windows, every meal is accompanied by sweeping vistas of the Garhwal valleys.
        </p>
        <p style="color: #475569; font-size: 15px; line-height: 1.8; margin-bottom: 25px;">
          Whether you are enjoying a slow mountain breakfast, a hearty post-trek lunch, or a candlelight dinner under starry skies, our chefs use farm-fresh ingredients to craft authentic Indian dishes tailored to every palate.
        </p>

        <!-- Timings Strip -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 15px; background: #ffffff; padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
          <div>
            <span style="font-size: 11px; font-weight: bold; color: var(--primary-blue); text-transform: uppercase;">BREAKFAST BUFFET</span>
            <div style="font-size: 14px; font-weight: bold; color: #1e293b;">8:30 AM - 10:00 AM</div>
          </div>
          <div>
            <span style="font-size: 11px; font-weight: bold; color: var(--primary-blue); text-transform: uppercase;">LUNCH BUFFET</span>
            <div style="font-size: 14px; font-weight: bold; color: #1e293b;">1:00 PM - 2:30 PM</div>
          </div>
          <div>
            <span style="font-size: 11px; font-weight: bold; color: var(--primary-blue); text-transform: uppercase;">DINNER BUFFET</span>
            <div style="font-size: 14px; font-weight: bold; color: #1e293b;">8:30 PM - 10:00 PM</div>
          </div>
        </div>
      </div>

      <div style="position: relative;">
        <div style="border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.08); border: 1px solid #e2e8f0;">
          <img src="/images/dining-interior-view.webp" alt="Restaurant Interior Flutter Hotels" style="width: 100%; height: 380px; object-fit: cover;">
        </div>
        <div style="position: absolute; bottom: -20px; left: -20px; background: #0f172a; color: #ffffff; padding: 18px 25px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 8px 25px rgba(0,0,0,0.2);" class="hide-mobile">
          <div style="font-size: 20px; font-weight: bold; color: #f59e0b;"><i class="fas fa-bell-concierge"></i> 24/7 Room Service Desk</div>
          <span style="font-size: 13px; color: #cbd5e1;">In-room dining available for all guest rooms</span>
        </div>
      </div>
    </div>

    <!-- Dining Experiences Showcase Cards -->
    <div style="margin-bottom: 60px;">
      <div style="text-align: center; max-width: 700px; margin: 0 auto 40px;">
        <span class="section-subtitle">Dining Highlights</span>
        <h2 class="section-title">Explore Our Dining Ambience</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px;">
        
        <!-- Card 1 -->
        <div style="background: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 6px 20px rgba(0,0,0,0.04); border: 1px solid #e2e8f0;">
          <img src="/images/dining-valley-table.webp" alt="Valley View Table" style="width: 100%; height: 210px; object-fit: cover;">
          <div style="padding: 22px;">
            <span style="background: rgba(95, 134, 193, 0.15); color: var(--primary-blue); padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: bold; text-transform: uppercase;">Valley View Tables</span>
            <h4 style="font-size: 18px; color: var(--dark-bg); margin: 10px 0 6px;">Floor-to-Ceiling Vistas</h4>
            <p style="color: #64748b; font-size: 13.5px; line-height: 1.6; margin: 0;">Dine with panoramic views of the Garhwal valley through large glass windows.</p>
          </div>
        </div>

        <!-- Card 2 -->
        <div style="background: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 6px 20px rgba(0,0,0,0.04); border: 1px solid #e2e8f0;">
          <img src="/images/dining-buffet-setup.webp" alt="Buffet Arrangement" style="width: 100%; height: 210px; object-fit: cover;">
          <div style="padding: 22px;">
            <span style="background: rgba(34, 197, 94, 0.15); color: #16a34a; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: bold; text-transform: uppercase;">Gourmet Buffets</span>
            <h4 style="font-size: 18px; color: var(--dark-bg); margin: 10px 0 6px;">Buffet & Live Counters</h4>
            <p style="color: #64748b; font-size: 13.5px; line-height: 1.6; margin: 0;">Sumptuous morning and evening buffets with live egg, dosa & tandoor counters.</p>
          </div>
        </div>

        <!-- Card 3 -->
        <div style="background: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 6px 20px rgba(0,0,0,0.04); border: 1px solid #e2e8f0;">
          <img src="/images/dining-tables-window.webp" alt="Cutlery & Window Setup" style="width: 100%; height: 210px; object-fit: cover;">
          <div style="padding: 22px;">
            <span style="background: rgba(245, 158, 11, 0.15); color: #d97706; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: bold; text-transform: uppercase;">Private Balcony Dining</span>
            <h4 style="font-size: 18px; color: var(--dark-bg); margin: 10px 0 6px;">In-Room & Balcony Meals</h4>
            <p style="color: #64748b; font-size: 13.5px; line-height: 1.6; margin: 0;">Enjoy intimate meals served directly on your room's private balcony overlooking nature.</p>
          </div>
        </div>

        <!-- Card 4 -->
        <div style="background: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 6px 20px rgba(0,0,0,0.04); border: 1px solid #e2e8f0;">
          <img src="/images/dining-hall-seating.webp" alt="Restaurant Hall Seating" style="width: 100%; height: 210px; object-fit: cover;">
          <div style="padding: 22px;">
            <span style="background: rgba(139, 92, 246, 0.15); color: #7c3aed; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: bold; text-transform: uppercase;">Banquet Seating</span>
            <h4 style="font-size: 18px; color: var(--dark-bg); margin: 10px 0 6px;">Group & Family Dining</h4>
            <p style="color: #64748b; font-size: 13.5px; line-height: 1.6; margin: 0;">Spacious indoor hall & lawn arrangement comfortable for 100 to 120 guests for family reunions, celebrations & corporate groups.</p>
          </div>
        </div>

      </div>
    </div>

    <!-- Cuisine Specialities Grid (Authentic Indian Cuisine Only) -->
    <div style="background: #ffffff; padding: 40px; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 8px 30px rgba(0,0,0,0.04); margin-bottom: 50px;">
      <div style="text-align: center; margin-bottom: 30px;">
        <span class="section-subtitle">Chef's Menu</span>
        <h3 style="font-size: 26px; color: var(--dark-bg); font-family: 'Cinzel', serif;">Authentic Indian Cuisine Served</h3>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">
        <div style="background: #f8fafc; padding: 22px; border-radius: 12px; border-left: 4px solid var(--primary-blue);">
          <h4 style="font-size: 17px; margin-bottom: 8px; color: var(--dark-bg);"><i class="fas fa-pepper-hot" style="color: var(--primary-blue);"></i> Garhwali Pahadi Specials</h4>
          <p style="color: #64748b; font-size: 13.5px; line-height: 1.6; margin: 0;">Authentic local Pahadi delicacies prepared with indigenous hill spices including Phaanu, Kafuli, Aloo ke Gutke & Mandwa Roti.</p>
        </div>

        <div style="background: #f8fafc; padding: 22px; border-radius: 12px; border-left: 4px solid #22c55e;">
          <h4 style="font-size: 17px; margin-bottom: 8px; color: var(--dark-bg);"><i class="fas fa-drumstick-bite" style="color: #22c55e;"></i> North Indian & Tandoori</h4>
          <p style="color: #64748b; font-size: 13.5px; line-height: 1.6; margin: 0;">Rich Paneer Butter Masala, Dal Makhani, Freshly Baked Tandoori Roti & Naan, Kadhai Paneer and Sizzling Kebabs.</p>
        </div>

        <div style="background: #f8fafc; padding: 22px; border-radius: 12px; border-left: 4px solid #f59e0b;">
          <h4 style="font-size: 17px; margin-bottom: 8px; color: var(--dark-bg);"><i class="fas fa-utensils" style="color: #f59e0b;"></i> South Indian & Breakfast Specials</h4>
          <p style="color: #64748b; font-size: 13.5px; line-height: 1.6; margin: 0;">Crispy Masala Dosa, Steamed Idli Sambhar, Stuffed Aloo Parathas, Puri Bhaji, and Freshly Brewed Pahadi Chai & Coffee.</p>
        </div>
      </div>
    </div>

    <!-- Table Reservation Callout -->
    <div style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff; padding: 45px; border-radius: 16px; text-align: center; max-width: 850px; margin: 0 auto;">
      <h3 style="font-size: 28px; font-family: 'Cinzel', serif; margin-bottom: 12px;">Reserve Your Table / Order Room Service</h3>
      <p style="color: #cbd5e1; font-size: 15px; margin-bottom: 25px;">
        Visiting with family or a group? Call our restaurant front desk at +91 89 2923 2740 or WhatsApp us for instant table booking & menu pre-orders.
      </p>
      <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20reserve%20a%20table%20at%20the%20Flutter%20Restaurant." target="_blank" class="btn-blue" style="background: #25d366 !important; border-color: #25d366 !important; padding: 13px 32px; font-size: 15px; font-weight: bold;">
        <i class="fab fa-whatsapp"></i> Chat on WhatsApp
      </a>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
