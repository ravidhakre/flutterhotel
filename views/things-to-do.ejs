<%- include('partials/header') %>

<!-- Page Header Banner -->
<div style="background: linear-gradient(rgba(26, 38, 56, 0.75), rgba(26, 38, 56, 0.75)), url('/images/hotel-img-4.jpeg') center/cover; padding: 70px 0; text-align: center; color: #fff;">
  <div class="container">
    <h1 style="font-size: 42px; margin-bottom: 10px; color: #ffffff;">Things To Do In Lansdowne</h1>
    <p style="color: var(--primary-blue); letter-spacing: 2px; text-transform: uppercase; font-weight: 600;">
      A quiet hill station with a handful of unmissable stops — all within easy reach of the resort.
    </p>
  </div>
</div>

<section class="section-padding">
  <div class="container">
    <p style="color: var(--text-muted); font-size: 16px; margin-bottom: 50px; text-align: center; max-width: 800px; margin-left: auto; margin-right: auto;">
      Lansdowne rewards slow travel. Beyond the resort, you’ll find temples, viewpoints, a colonial-era church, a war memorial, a waterfall and a lake — each an easy trip from Flutter Hotels & Resorts.
    </p>

    <!-- Attractions Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px; margin-bottom: 60px;">
      
      <div style="background: #fff; border-radius: 12px; border: 1.5px solid #e2e8f0; overflow: hidden; box-shadow: var(--shadow-sm);">
        <img src="/images/hotel-img-6.jpg" alt="Tarkeshwar Mahadev Temple" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 25px;">
          <h3 style="font-size: 22px; color: var(--dark-bg); margin-bottom: 10px;">Tarkeshwar Mahadev Temple</h3>
          <p style="color: var(--text-muted); font-size: 14px;">A revered Shiva temple set among pine and cedar trees — a peaceful stop for morning darshan or a quiet walk.</p>
        </div>
      </div>

      <div style="background: #fff; border-radius: 12px; border: 1.5px solid #e2e8f0; overflow: hidden; box-shadow: var(--shadow-sm);">
        <img src="/images/hotel-img-1.jpg" alt="Tip-in-Top Point" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 25px;">
          <h3 style="font-size: 22px; color: var(--dark-bg); margin-bottom: 10px;">Tip-in-Top Point (Tiffin Top)</h3>
          <p style="color: var(--text-muted); font-size: 14px;">Lansdowne’s well-known viewpoint for sunrise and sunset, with sweeping views over the surrounding Garhwal hills.</p>
        </div>
      </div>

      <div style="background: #fff; border-radius: 12px; border: 1.5px solid #e2e8f0; overflow: hidden; box-shadow: var(--shadow-sm);">
        <img src="/images/hotel-img-7.jpg" alt="St. Mary’s Church" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 25px;">
          <h3 style="font-size: 22px; color: var(--dark-bg); margin-bottom: 10px;">St. Mary’s Church</h3>
          <p style="color: var(--text-muted); font-size: 14px;">Built in 1895, this colonial-era church is one of Lansdowne’s oldest landmarks — worth a visit for its history and architecture.</p>
        </div>
      </div>

      <div style="background: #fff; border-radius: 12px; border: 1.5px solid #e2e8f0; overflow: hidden; box-shadow: var(--shadow-sm);">
        <img src="/images/hotel-img-8.jpg" alt="Garhwal Rifles War Memorial" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 25px;">
          <h3 style="font-size: 22px; color: var(--dark-bg); margin-bottom: 10px;">Garhwal Rifles Regimental War Memorial</h3>
          <p style="color: var(--text-muted); font-size: 14px;">A memorial honouring the Garhwal Rifles regiment — a meaningful stop for anyone interested in military history.</p>
        </div>
      </div>

      <div style="background: #fff; border-radius: 12px; border: 1.5px solid #e2e8f0; overflow: hidden; box-shadow: var(--shadow-sm);">
        <img src="/images/hotel-img-9.jpeg" alt="Bhalugarh Waterfalls" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 25px;">
          <h3 style="font-size: 22px; color: var(--dark-bg); margin-bottom: 10px;">Bhalugarh Waterfalls</h3>
          <p style="color: var(--text-muted); font-size: 14px;">A scenic waterfall on the outskirts of town, a good half-day trip for those who enjoy a short trek through forest paths.</p>
        </div>
      </div>

      <div style="background: #fff; border-radius: 12px; border: 1.5px solid #e2e8f0; overflow: hidden; box-shadow: var(--shadow-sm);">
        <img src="/images/hotel-img-10.jpeg" alt="Bhulla Tal Lake" style="width: 100%; height: 200px; object-fit: cover;">
        <div style="padding: 25px;">
          <h3 style="font-size: 22px; color: var(--dark-bg); margin-bottom: 10px;">Bhulla Tal Lake</h3>
          <p style="color: var(--text-muted); font-size: 14px;">A small lake in the heart of Lansdowne offering boating — a relaxed way to spend an afternoon with family.</p>
        </div>
      </div>

    </div>

    <!-- Getting Here Box -->
    <div style="background: var(--light-bg); padding: 30px; border-radius: 12px; border: 1.5px solid #e2e8f0; text-align: center; max-width: 800px; margin: 0 auto 40px;">
      <h3 style="font-size: 22px; margin-bottom: 15px; color: var(--dark-bg);"><i class="fas fa-route" style="color: var(--primary-blue);"></i> Getting Here</h3>
      <p style="color: var(--text-muted); font-size: 15px; margin-bottom: 10px;"><strong>Nearest Airport:</strong> Dehradun (Jolly Grant Airport)</p>
      <p style="color: var(--text-muted); font-size: 15px;"><strong>Nearest Railway Station:</strong> Kotdwara Railway Station</p>
    </div>

    <div style="text-align: center;">
      <a href="/rooms" class="btn-blue" style="padding: 14px 36px; font-size: 16px;"><i class="fas fa-bed"></i> Plan Your Stay & Book Direct</a>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
