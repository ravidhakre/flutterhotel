  <div class="container" style="max-width: 800px;">
    <h2 style="font-size: 32px; font-family: 'Cinzel', serif; color: #ffffff; margin-bottom: 12px;">Need Custom Sightseeing & Transport Arrangements?</h2>
    <p style="color: #cbd5e1; font-size: 16px; margin-bottom: 25px; line-height: 1.6;">
      Let our resort front desk handle your local transportation, private cab rentals, and guided hill tours so you can relax and enjoy Lansdowne stress-free.
    </p>
    <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
      <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I'd%20like%20to%20book%20a%20sightseeing%20cab%20during%20my%20stay%20at%20Flutter%20Hotels." target="_blank" class="btn-blue" style="background: #25d366 !important; border-color: #25d366 !important; padding: 14px 30px; font-size: 15px;">
        <i class="fab fa-whatsapp"></i> Chat with Concierge
      </a>
      <a href="tel:<%= phoneMain.replace(/\s+/g, '') %>" class="btn-outline-blue" style="padding: 14px 28px; font-size: 15px;">
        <i class="fas fa-phone-alt"></i> Call +91 89 2923 2740
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
