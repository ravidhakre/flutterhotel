<%- include('partials/header') %>

<!-- Things To Do Hero Banner -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.8)), url('/images/tip-n-top-viewpoint.jpg'); background-size: cover; background-position: center;">
