<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Flutter Hotels & Resorts | Hill Resort in Lansdowne' %></title>
  <% if (typeof metaDesc !== 'undefined') { %>
    <meta name="description" content="<%= metaDesc %>">
  <% } %>
  
  <!-- FontAwesome & Google Fonts -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Top Header Bar -->
  <div class="top-header">
    <div class="container">
      <div class="top-header-info">
        <span class="top-info-item"><i class="fas fa-location-dot"></i> Palkot–Lansdowne, Garhwal, Uttarakhand</span>
        <span class="top-info-divider">|</span>
        <span class="top-info-item"><i class="fas fa-phone-alt"></i> Direct: <a href="tel:<%= phoneMain.replace(/\s+/g, '') %>"><%= phoneMain %></a></span>
        <span class="top-info-divider desktop-only">|</span>
        <span class="top-info-item desktop-only"><i class="fas fa-envelope"></i> <%= emailMain %></span>
      </div>
      
      <div class="top-header-links">
        <div class="top-social-icons">
          <a href="https://www.facebook.com/FlutterHotelsAndResortPvtLtd" target="_blank" title="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="https://www.instagram.com/flutterhotelsandresort/" target="_blank" title="Instagram"><i class="fab fa-instagram"></i></a>
          <a href="https://www.youtube.com/@FlutterHotelsAndResort" target="_blank" title="YouTube"><i class="fab fa-youtube"></i></a>
          <a href="https://www.linkedin.com/company/104592582/admin/dashboard/" target="_blank" title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
        </div>
        
        <% if (user) { %>
          <% if (user.isAdmin) { %>
            <a href="/admin" class="top-admin-badge"><i class="fas fa-chart-line"></i> Admin Portal</a>
          <% } %>
          <a href="/logout" class="top-link-btn"><i class="fas fa-sign-out-alt"></i> Logout</a>
        <% } else { %>
          <a href="/login" class="top-link-btn"><i class="fas fa-user"></i> Login</a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Luxury Main Navigation Bar -->
  <nav class="main-navbar">
    <div class="container navbar-inner">
      <!-- Clean Brand Logo Image Only -->
      <a href="/" class="navbar-brand-logo" title="Flutter Hotels & Resorts">
        <img src="/images/logo.avif" alt="Flutter Hotels & Resorts" class="brand-logo-img">
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle Menu">
        <i class="fas fa-bars-staggered"></i>
      </button>

      <!-- Nav Links -->
      <div class="nav-links" id="primaryNavLinks">
        <a href="/" class="nav-item-link <%= (typeof title !== 'undefined' && title.includes('Flutter Hotels & Resorts | Hill Resort')) ? 'active' : '' %>">
          <span>Home</span>
        </a>
        <a href="/rooms" class="nav-item-link <%= (typeof title !== 'undefined' && title.includes('Rooms')) ? 'active' : '' %>">
          <span>Rooms</span>
        </a>
        <a href="/dining" class="nav-item-link <%= (typeof title !== 'undefined' && title.includes('Dining')) ? 'active' : '' %>">
          <span>Dining</span>
        </a>
        <a href="/packages" class="nav-item-link <%= (typeof title !== 'undefined' && title.includes('Packages')) ? 'active' : '' %>">
          <span>Packages</span>
        </a>
        <a href="/offers" class="nav-item-link <%= (typeof title !== 'undefined' && title.includes('Offers') && !title.includes('Packages')) ? 'active' : '' %>">
          <span>Offers</span>
        </a>
        <a href="/things-to-do" class="nav-item-link <%= (typeof title !== 'undefined' && title.includes('Things To Do')) ? 'active' : '' %>">
          <span>Things To Do</span>
        </a>

        <!-- More Dropdown -->
        <div class="nav-item-dropdown" id="moreDropdownContainer">
          <a href="#" class="nav-item-link dropdown-toggle" id="moreDropdownBtn">
            <span>More</span> <i class="fas fa-chevron-down dropdown-arrow" style="font-size: 11px; margin-left: 4px;"></i>
          </a>
          <div class="dropdown-menu-box" id="moreDropdownMenu">
            <a href="/meetings-events" class="dropdown-item-link"><i class="fas fa-handshake"></i> Meetings & Events</a>
            <a href="/gallery" class="dropdown-item-link"><i class="fas fa-images"></i> Gallery</a>
            <a href="/celebrations" class="dropdown-item-link"><i class="fas fa-glass-cheers"></i> Celebrations</a>
            <a href="/group-booking" class="dropdown-item-link"><i class="fas fa-users"></i> Group Booking</a>
            <a href="/facilities" class="dropdown-item-link"><i class="fas fa-concierge-bell"></i> Facilities</a>
            <a href="/location" class="dropdown-item-link"><i class="fas fa-map-location-dot"></i> Location</a>
            <a href="/contact" class="dropdown-item-link"><i class="fas fa-envelope"></i> Contact Us</a>
            <a href="/blog" class="dropdown-item-link"><i class="fas fa-blog"></i> Blog</a>
          </div>
        </div>
        <% if (isAdmin) { %>
          <a href="/admin" class="nav-item-link admin-nav-link"><i class="fas fa-crown"></i> Admin</a>
        <% } %>

        <div class="mobile-social-bar">
          <a href="https://www.facebook.com/FlutterHotelsAndResortPvtLtd" target="_blank" title="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="https://www.instagram.com/flutterhotelsandresort/" target="_blank" title="Instagram"><i class="fab fa-instagram"></i></a>
          <a href="https://www.youtube.com/@FlutterHotelsAndResort" target="_blank" title="YouTube"><i class="fab fa-youtube"></i></a>
          <a href="https://www.linkedin.com/company/104592582/admin/dashboard/" target="_blank" title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
        </div>

        <a href="/rooms" class="header-booking-btn pulsing-btn">
          <i class="fas fa-calendar-check"></i> <span>BOOK NOW</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Mobile Overlay -->
  <div class="mobile-nav-overlay" id="mobileNavOverlay"></div>

  <!-- Floating WhatsApp Button -->
  <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I’d%20like%20to%20know%20more%20about%20Flutter%20Hotels%20%26%20Resorts." target="_blank" class="whatsapp-float-btn" title="Chat on WhatsApp">
    <i class="fab fa-whatsapp"></i>
  </a>
