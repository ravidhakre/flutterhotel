<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Flutter Hotels & Resorts | Hill Resort in Lansdowne' %></title>
  <% if (typeof metaDesc !== 'undefined') { %>
    <meta name="description" content="<%= metaDesc %>">
  <% } %>
  
  <!-- FontAwesome & Google Fonts -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Top Header Bar -->
  <div class="top-header">
    <div class="container">
      <div class="top-header-info">
        <span><i class="fas fa-location-dot"></i> Palkot–Lansdowne, Uttarakhand</span>
        <span><i class="fas fa-phone"></i> Call: <a href="tel:<%= phoneMain.replace(/\s+/g, '') %>" style="color: #ffffff; font-weight: bold;"><%= phoneMain %></a></span>
      </div>
      <div class="top-header-links">
        <% if (user) { %>
          <span><i class="fas fa-user-circle"></i> Hi, <strong><%= user.name %></strong></span>
          <% if (user.isAdmin) { %>
            <a href="/admin" style="color: var(--primary-blue); font-weight: bold;"><i class="fas fa-chart-line"></i> Admin Panel</a>
          <% } %>
          <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        <% } else { %>
          <a href="/login"><i class="fas fa-user"></i> Guest / Admin Login</a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <nav class="main-navbar">
    <div class="container navbar-inner">
      <!-- Clean Logo (Image Only) -->
      <a href="/" class="navbar-brand-logo">
        <img src="/images/logo.avif" alt="Flutter Hotels & Resorts Logo" class="brand-logo-img">
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle Menu">
        <i class="fas fa-bars"></i>
      </button>

      <!-- Nav Links -->
      <div class="nav-links" id="primaryNavLinks">
        <a href="/" class="<%= (typeof title !== 'undefined' && title.includes('Flutter Hotels & Resorts | Hill Resort')) ? 'active' : '' %>">Home</a>
        <a href="/rooms" class="<%= (typeof title !== 'undefined' && title.includes('Rooms')) ? 'active' : '' %>">Rooms</a>
        <a href="/offers" class="<%= (typeof title !== 'undefined' && title.includes('Offers')) ? 'active' : '' %>">Offers & Packages</a>
        <a href="/things-to-do" class="<%= (typeof title !== 'undefined' && title.includes('Things To Do')) ? 'active' : '' %>">Things To Do</a>
        <a href="/dining" class="<%= (typeof title !== 'undefined' && title.includes('Dining')) ? 'active' : '' %>">Dining</a>
        <a href="/gallery" class="<%= (typeof title !== 'undefined' && title.includes('Gallery')) ? 'active' : '' %>">Gallery</a>
        <a href="/contact" class="<%= (typeof title !== 'undefined' && title.includes('Contact')) ? 'active' : '' %>">Contact Us</a>
        <% if (isAdmin) { %>
          <a href="/admin" style="color: var(--primary-blue); font-weight: bold;"><i class="fas fa-crown"></i> Admin</a>
        <% } %>
        <a href="/rooms" class="btn-blue header-booking-btn">Book Now</a>
      </div>
    </div>
  </nav>

  <!-- Mobile Overlay -->
  <div class="mobile-nav-overlay" id="mobileNavOverlay"></div>

  <!-- Floating WhatsApp Button -->
  <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I’d%20like%20to%20know%20more%20about%20Flutter%20Hotels%20%26%20Resorts." target="_blank" class="whatsapp-float-btn" title="Chat on WhatsApp">
    <i class="fab fa-whatsapp"></i>
  </a>
