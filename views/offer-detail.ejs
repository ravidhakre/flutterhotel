<%- include('partials/header') %>

<div style="background: var(--dark-bg); color: #fff; padding: 50px 0;">
  <div class="container">
    <span style="color: var(--primary-blue); text-transform: uppercase; letter-spacing: 2px; font-weight: 600;"><%= offer.tag %></span>
    <h1 style="font-size: 38px; margin-top: 5px; color: #ffffff;"><%= offer.title %></h1>
  </div>
</div>

<section class="section-padding">
  <div class="container">
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 40px;">
      
      <!-- Main Content -->
      <div>
        <img src="<%= offer.image %>" alt="<%= offer.title %>" style="width: 100%; height: 380px; object-fit: cover; border-radius: 12px; margin-bottom: 30px; box-shadow: var(--shadow-sm);">

        <h3 style="font-size: 26px; margin-bottom: 15px;">Package Highlights & Details</h3>
        <p style="color: var(--text-muted); font-size: 16px; margin-bottom: 30px; line-height: 1.8;">
          <%= offer.shortDesc %>
        </p>

        <div style="background: var(--light-bg); padding: 30px; border-radius: 12px; border: 1.5px solid #e2e8f0; margin-bottom: 40px;">
          <h4 style="font-size: 20px; margin-bottom: 20px; color: var(--dark-bg);"><i class="fas fa-star" style="color: var(--primary-blue);"></i> What’s Included in This Package:</h4>
          <ul style="display: flex; flex-direction: column; gap: 12px;">
            <% offer.highlights.forEach(item => { %>
              <li style="display: flex; align-items: center; gap: 10px; font-size: 15px;">
                <i class="fas fa-check-circle" style="color: var(--primary-blue);"></i>
                <span><%= item %></span>
              </li>
            <% }); %>
          </ul>
        </div>

        <% if (offer.faqs && offer.faqs.length > 0) { %>
          <h3 style="font-size: 24px; margin-bottom: 20px;">Frequently Asked Questions</h3>
          <div style="background: var(--light-bg); padding: 25px; border-radius: 10px; border: 1px solid #e2e8f0; margin-bottom: 40px;">
            <% offer.faqs.forEach(faq => { %>
              <div style="margin-bottom: 15px;">
                <strong style="font-size: 16px; color: var(--dark-bg); display: block;">Q: <%= faq.q %></strong>
                <p style="color: var(--text-muted); margin-top: 4px;"><%= faq.a %></p>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>

      <!-- Action Sidebar -->
      <div>
        <div style="background: #ffffff; padding: 30px; border-radius: 12px; border: 2px solid var(--primary-blue); box-shadow: var(--shadow-lg); position: sticky; top: 100px; text-align: center;">
          <span style="font-size: 13px; color: #888; text-transform: uppercase;">Package Rate</span>
          <div style="font-size: 28px; font-weight: bold; color: var(--primary-blue); margin-bottom: 20px;"><%= offer.price %></div>

          <a href="https://wa.me/<%= whatsappNum %>?text=Hi,%20I’d%20like%20to%20enquire%20about%20the%20<%= encodeURIComponent(offer.title) %>." target="_blank" class="btn-blue" style="width: 100%; padding: 14px; margin-bottom: 15px; background: #25d366 !important; border-color: #25d366 !important;">
            <i class="fab fa-whatsapp"></i> Enquire on WhatsApp
          </a>

          <a href="/contact" class="btn-outline-blue" style="width: 100%; display: block; padding: 12px;">
            <i class="fas fa-envelope"></i> Send Website Enquiry
          </a>

          <div style="margin-top: 20px; font-size: 13px; color: #666; border-top: 1px solid #eee; padding-top: 15px;">
            <i class="fas fa-phone-alt" style="color: var(--primary-blue);"></i> Call Direct: <strong>+91 89 2923 2740</strong>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<%- include('partials/footer') %>
