<%- include('partials/header') %>

<!-- Packages Hero Banner (Full-Height Mobile Responsive) -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.8)), url('/images/packages-hero-banner.jpg');">
  <div class="container" style="max-width: 900px; position: relative; z-index: 2;">
    <h1 style="font-size: 44px; margin-bottom: 14px; color: #ffffff; font-family: 'Cinzel', serif; line-height: 1.25;">Exclusive Flutter Hotels & Resort Packages</h1>
    <p style="color: #cbd5e1; font-size: 16.5px; line-height: 1.7; max-width: 760px; margin: 0 auto 25px;">
      Honeymoon Escapes • Delhi Group Departures • Weekend Breakaways • MICE & Destination Weddings — all-inclusive packages with meals, bonfire evenings, and valley stays.
    </p>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    
    <div style="text-align: center; max-width: 750px; margin: 0 auto 40px;">
      <h2 class="section-title">Packages Tailored for Every Occasion</h2>
    </div>

    <!-- Packages Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
      <% packages.forEach(function(pkg) { %>
        <div style="background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; display: flex; flex-direction: column; transition: transform 0.3s ease;">
          
          <!-- Swipeable Image Carousel Container with Tag Badge -->
          <div style="position: relative; height: 250px; overflow: hidden;">
            <% if (pkg.images && pkg.images.length > 1) { %>
              <div style="display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; height: 100%; width: 100%;">
                <% pkg.images.forEach(function(imgUrl, imgIdx) { %>
                  <div style="flex: 0 0 100%; scroll-snap-align: start; height: 100%; position: relative;">
                    <img src="<%= imgUrl %>" alt="<%= pkg.title %> - Photo <%= imgIdx + 1 %>" style="width: 100%; height: 100%; object-fit: cover;">
                  </div>
                <% }); %>
              </div>
              <span style="position: absolute; bottom: 12px; left: 12px; background: rgba(15, 23, 42, 0.82); color: #ffffff; padding: 3px 10px; border-radius: 12px; font-size: 10.5px; font-weight: 600; backdrop-filter: blur(4px); pointer-events: none;">
                <i class="fas fa-arrows-left-right"></i> Scroll Photos (<%= pkg.images.length %>)
              </span>
            <% } else { %>
              <img src="<%= pkg.image %>" alt="<%= pkg.title %>" style="width: 100%; height: 100%; object-fit: cover;">
            <% } %>
            
            <span style="position: absolute; top: 15px; right: 15px; background: rgba(15, 23, 42, 0.85); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 5px 14px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; backdrop-filter: blur(4px); pointer-events: none;">
              <i class="fas fa-star"></i> <%= pkg.tag %>
            </span>
          </div>

          <!-- Content Body -->
          <div style="padding: 28px; flex-grow: 1; display: flex; flex-direction: column;">
            <h3 style="font-size: 22px; color: var(--dark-bg); margin-bottom: 10px; font-family: 'Cinzel', serif; line-height: 1.3;"><%= pkg.title %></h3>
            
            <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;">
              <%= pkg.shortDesc %>
            </p>

            <!-- Professional Luxury Price Strip -->
            <div style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); padding: 14px 18px; border-radius: 12px; border: 1px solid #cbd5e1; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; box-shadow: inset 0 1px 0 rgba(255,255,255,0.9), 0 2px 6px rgba(0,0,0,0.02);">
              <div style="display: flex; flex-direction: column; min-width: 0;">
                <span style="font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.8px; color: #64748b; font-weight: 700; margin-bottom: 4px; display: block;">
                  Package Tariff
                </span>
                
                <% 
                  let priceStr = pkg.price || '';
                  let pMatch = priceStr.match(/(?:(Starting\s+from)\s+)?(₹[\d,]+)(?:\s*[\/\-]\s*(.+))?/i);
                  let pPrefix = pMatch && pMatch[1] ? pMatch[1] : '';
                  let pAmount = pMatch && pMatch[2] ? pMatch[2] : priceStr;
                  let pUnit = pMatch && pMatch[3] ? pMatch[3] : '';
                %>
                
                <div style="display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px; line-height: 1.2;">
                  <% if (pPrefix) { %>
                    <span style="font-size: 12px; color: #64748b; font-weight: 500;">Starting from</span>
                  <% } %>
                  <span style="font-size: 24px; font-weight: 800; color: #0f172a; font-family: 'Cinzel', serif; letter-spacing: -0.5px;"><%= pAmount %></span>
                  <% if (pUnit) { %>
                    <span style="font-size: 13px; font-weight: 600; color: #475569;">/ <%= pUnit %></span>
                  <% } %>
                </div>
              </div>

              <span style="background: #dcfce7; color: #15803d; border: 1px solid #a7f3d0; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; white-space: nowrap; display: inline-flex; align-items: center; gap: 4px; flex-shrink: 0; box-shadow: 0 1px 2px rgba(0,0,0,0.03);">
                <i class="fas fa-shield-check" style="font-size: 11px; color: #16a34a;"></i> Best Rate
              </span>
            </div>

            <!-- Dual Action Buttons with Direct WhatsApp Inquiry -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <a href="/packages/<%= pkg.slug %>" class="btn-outline-blue" style="padding: 11px 0; font-size: 13px; text-align: center; font-weight: bold; border-radius: 8px;">
                <i class="fas fa-info-circle"></i> View Details
              </a>
              <a href="https://wa.me/918929232740?text=<%= encodeURIComponent('Hi, I am interested in inquiring and booking the ' + pkg.title + ' at Flutter Hotels & Resorts.') %>" target="_blank" style="background: #25D366; color: #ffffff; padding: 11px 0; font-size: 13px; text-align: center; font-weight: bold; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 6px; box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);">
                <i class="fab fa-whatsapp" style="font-size: 16px;"></i> Enquire Package
              </a>
            </div>

          </div>
        </div>
      <% }); %>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
