<%- include('partials/header') %>

<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.8)), url('/images/hotel-img-3.jpg');">
  <div class="container" style="max-width: 900px;">
    <h1 style="font-size: 42px; margin-bottom: 12px; color: #ffffff;">Exclusive Holiday & Experience Packages</h1>
    <p style="color: #cbd5e1; font-size: 16px; line-height: 1.6;">
      Honeymoon Escapes • Group Departures • Weekend Breakaways • MICE & Weddings
    </p>
  </div>
</div>

<section class="section-padding">
  <div class="container">
    
    <div style="text-align: center; max-width: 750px; margin: 0 auto 50px;">
      <span class="section-subtitle">Curated Himalayan Experiences</span>
      <h2 class="section-title">Packages Tailored for Every Occasion</h2>
      <p style="color: var(--text-muted); font-size: 15px;">
        Choose from our handcrafted all-inclusive packages at Flutter Hotels & Resorts, Lansdowne. Meals, bonfire evenings, and scenic hill views included.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 30px;">
      <% packages.forEach(function(pkg) { %>
        <div style="background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 8px 25px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; display: flex; flex-direction: column; transition: transform 0.3s ease;">
          
          <div style="position: relative; height: 220px;">
            <img src="<%= pkg.image %>" alt="<%= pkg.title %>" style="width: 100%; height: 100%; object-fit: cover;">
            <span style="position: absolute; top: 15px; right: 15px; background: var(--primary-blue); color: #fff; padding: 6px 14px; border-radius: 20px; font-size: 11px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 4px 10px rgba(0,0,0,0.2);">
              <%= pkg.tag %>
            </span>
          </div>

          <div style="padding: 25px; flex-grow: 1; display: flex; flex-direction: column;">
            <h3 style="font-size: 20px; color: var(--dark-bg); margin-bottom: 10px; line-height: 1.4;"><%= pkg.title %></h3>
            <p style="color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;">
              <%= pkg.shortDesc %>
            </p>

            <div style="background: #f8fafc; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; border: 1px solid #f1f5f9;">
              <div>
                <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600;">Package Price</span>
                <div style="font-size: 18px; font-weight: bold; color: var(--primary-blue);"><%= pkg.price %></div>
              </div>
              <a href="/packages/<%= pkg.slug %>" class="btn-blue" style="font-size: 12px; padding: 8px 18px;">View Details <i class="fas fa-arrow-right"></i></a>
            </div>

          </div>
        </div>
      <% }); %>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
