<style>
/* Filter Buttons */
.gallery-filter-btn {
  background: #ffffff;
  color: #475569;
  border: 1px solid #cbd5e1;
  padding: 10px 20px;
  border-radius: 30px;
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s ease;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.gallery-filter-btn:hover, .gallery-filter-btn.active {
  background: var(--primary-blue);
  color: #ffffff;
  border-color: var(--primary-blue);
  box-shadow: 0 4px 15px rgba(95, 134, 193, 0.3);
}

/* Gallery Item Cards */
.gallery-item-card {
  position: relative;
  height: 250px;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 6px 20px rgba(0,0,0,0.06);
  border: 1px solid #e2e8f0;
  cursor: pointer;
}
.gallery-item-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.gallery-item-card:hover img {
  transform: scale(1.08);
}
.gallery-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.1));
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0.9;
  transition: opacity 0.3s ease;
}
.gallery-item-card:hover .gallery-card-overlay {
  opacity: 1;
}
.gallery-badge {
  background: rgba(245, 158, 11, 0.3);
  color: #f59e0b;
  border: 1px solid rgba(245, 158, 11, 0.5);
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
  width: fit-content;
  margin-bottom: 6px;
  backdrop-filter: blur(4px);
}
.gallery-card-title {
  color: #ffffff;
  margin: 0 0 6px;
  font-size: 16px;
  font-family: 'Cinzel', serif;
}
.gallery-expand-tag {
  color: #cbd5e1;
  font-size: 12px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* Lightbox Modal CSS */
.gallery-lightbox-modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(15, 23, 42, 0.95);
  backdrop-filter: blur(8px);
  justify-content: center;
  align-items: center;
  padding: 20px;
}
.gallery-lightbox-modal.show {
  display: flex;
}
.lightbox-close-btn {
  position: absolute;
  top: 25px;
  right: 30px;
  background: none;
  border: none;
  color: #ffffff;
  font-size: 40px;
  cursor: pointer;
  z-index: 10001;
  line-height: 1;
}
.lightbox-nav-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255,255,255,0.15);
  color: #ffffff;
  border: 1px solid rgba(255,255,255,0.3);
  width: 50px;
  height: 50px;
  border-radius: 50%;
  font-size: 20px;
  cursor: pointer;
  z-index: 10001;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
  transition: background 0.2s ease;
}
.lightbox-nav-btn:hover {
  background: var(--primary-blue);
}
.lightbox-prev-btn { left: 25px; }
.lightbox-next-btn { right: 25px; }

.lightbox-content-box {
  max-width: 900px;
  width: 100%;
  background: #0f172a;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid #334155;
  box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  display: flex;
  flex-direction: column;
}
.lightbox-content-box img {
  width: 100%;
  max-height: 70vh;
  object-fit: contain;
  background: #000;
}
.lightbox-caption-bar {
  padding: 20px 25px;
  background: #0f172a;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid #1e293b;
}
.lightbox-category-badge {
  background: var(--primary-blue);
  color: #ffffff;
  padding: 3px 12px;
  border-radius: 12px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
}
</style>

<script>
// Lightbox Data & Filtering Script
const allGalleryItems = Array.from(document.querySelectorAll('.gallery-item-card')).map(card => {
  return {
    src: card.querySelector('img').src,
    title: card.querySelector('.gallery-card-title').innerText,
    category: card.dataset.category,
    categoryName: card.querySelector('.gallery-badge').innerText
  };
});

let currentLightboxIndex = 0;
let filteredIndices = allGalleryItems.map((_, idx) => idx);

function filterGallery(category, btnEl) {
  // Update Active Button
  document.querySelectorAll('.gallery-filter-btn').forEach(btn => btn.classList.remove('active'));
  if (btnEl) btnEl.classList.add('active');

  const cards = document.querySelectorAll('.gallery-item-card');
  filteredIndices = [];

  cards.forEach((card, idx) => {
    if (category === 'all' || card.dataset.category === category) {
      card.style.display = 'block';
      filteredIndices.push(idx);
    } else {
      card.style.display = 'none';
    }
  });
}

function openLightbox(index) {
  currentLightboxIndex = index;
  updateLightbox();
  document.getElementById('galleryLightboxModal').classList.add('show');
  document.body.style.overflow = 'hidden';
}

function closeLightbox() {
  document.getElementById('galleryLightboxModal').classList.remove('show');
  document.body.style.overflow = '';
}

function navigateLightbox(direction) {
  const currentPos = filteredIndices.indexOf(currentLightboxIndex);
  let nextPos = currentPos + direction;
  if (nextPos < 0) nextPos = filteredIndices.length - 1;
  if (nextPos >= filteredIndices.length) nextPos = 0;
  currentLightboxIndex = filteredIndices[nextPos];
  updateLightbox();
}

function updateLightbox() {
  const item = allGalleryItems[currentLightboxIndex];
  if (!item) return;
  document.getElementById('lightboxImage').src = item.src;
  document.getElementById('lightboxTitle').innerText = item.title;
  document.getElementById('lightboxCategory').innerText = item.categoryName;
  
  const currentPos = filteredIndices.indexOf(currentLightboxIndex) + 1;
  document.getElementById('lightboxCounter').innerText = `Photo ${currentPos} of ${filteredIndices.length}`;
}

// Keyboard Controls
document.addEventListener('keydown', (e) => {
  const modal = document.getElementById('galleryLightboxModal');
  if (modal.classList.contains('show')) {
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navigateLightbox(-1);
    if (e.key === 'ArrowRight') navigateLightbox(1);
  }
});
</script>

