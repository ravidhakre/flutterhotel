<%- include('partials/header') %>

<!-- Page Header Banner -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.8)), url('/images/hotel-img-13.jpeg');">
