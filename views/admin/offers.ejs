<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Manage Offers | Flutter Hotels Admin' %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">

  <aside class="admin-sidebar">
    <div class="sidebar-header" style="display: flex; align-items: center; gap: 10px;">
      <img src="/images/logo.avif" alt="Logo" style="height: 35px; background: #fff; padding: 2px; border-radius: 4px;"> FLUTTER ADMIN
    </div>
    <ul class="sidebar-menu">
      <li><a href="/admin"><i class="fas fa-chart-line"></i> Dashboard</a></li>
      <li><a href="/admin/bookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
      <li><a href="/admin/rooms"><i class="fas fa-bed"></i> Room Inventory</a></li>
      <li><a href="/admin/offers" class="active"><i class="fas fa-tags"></i> Special Offers & Deals</a></li>
      <li><a href="/admin/blogs"><i class="fas fa-blog"></i> CMS Travel Blogs</a></li>
      <li><a href="/admin/inquiries"><i class="fas fa-envelope"></i> Customer Enquiries</a></li>
      <li style="margin-top: 40px;"><a href="/" target="_blank"><i class="fas fa-external-link-alt"></i> View Main Website</a></li>
      <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="admin-main">
    <header class="admin-topbar">
      <h2 style="margin: 0; font-size: 22px;">Monthly Offer Slider & Promotions Manager</h2>
      <button onclick="document.getElementById('newOfferModal').style.display='flex'" class="btn-admin btn-admin-primary">
        <i class="fas fa-plus"></i> Create New Monthly Offer
      </button>
    </header>

    <div class="admin-content">
      
      <div style="background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.05); overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
          <thead>
            <tr style="background: #f1f5f9; color: #475569; font-size: 13px; text-transform: uppercase;">
              <th style="padding: 16px 20px;">Banner Image</th>
              <th style="padding: 16px 20px;">Offer Title & Subtitle</th>
              <th style="padding: 16px 20px;">Button Text & Target Link</th>
              <th style="padding: 16px 20px;">Validity / Expiry</th>
              <th style="padding: 16px 20px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (offers && offers.length > 0) { %>
              <% offers.forEach(function(offer) { %>
                <tr style="border-bottom: 1px solid #f1f5f9; font-size: 14px;">
                  <td style="padding: 15px 20px;">
                    <img src="<%= offer.image %>" alt="<%= offer.title %>" style="width: 80px; height: 50px; object-fit: cover; border-radius: 6px;">
                  </td>
                  <td style="padding: 15px 20px; max-width: 320px;">
                    <strong style="color: var(--dark-bg); display: block; font-size: 15px; margin-bottom: 4px;"><%= offer.title %></strong>
                    <span style="font-size: 12px; color: #64748b;"><%= offer.subtitle || offer.shortDesc %></span>
                  </td>
                  <td style="padding: 15px 20px;">
                    <span style="background: #e0f2fe; color: #0284c7; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: bold; display: inline-block; margin-bottom: 4px;">
                      <i class="fas fa-link"></i> <%= offer.btnText || 'Claim Offer' %>
                    </span>
                    <div style="font-size: 11px; color: #64748b; word-break: break-all;"><%= offer.btnLink || '/checkout' %></div>
                  </td>
                  <td style="padding: 15px 20px; font-weight: bold; color: #166534; font-size: 13px;">
                    <i class="fas fa-clock"></i> <%= offer.validity || 'Active' %>
                  </td>
                  <td style="padding: 15px 20px;">
                    <div style="display: flex; gap: 8px;">
                      <a href="/offers" target="_blank" class="btn-outline-blue" style="padding: 6px 12px; font-size: 12px;" title="View Slider"><i class="fas fa-eye"></i> View</a>
                      <button onclick="deleteOffer('<%= offer.id %>')" class="btn-blue" style="background: #ef4444 !important; border-color: #ef4444 !important; padding: 6px 12px; font-size: 12px;" title="Delete Offer"><i class="fas fa-trash"></i> Delete</button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" style="padding: 30px; text-align: center; color: #64748b;">No monthly offers created yet. Click 'Create New Monthly Offer' to create one.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </div>
  </main>

  <!-- Create New Monthly Offer Modal -->
  <div id="newOfferModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 2000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #ffffff; width: 90%; max-width: 800px; max-height: 90vh; overflow-y: auto; border-radius: 12px; padding: 35px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);">
      
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 2px solid #f1f5f9; padding-bottom: 15px;">
        <h3 style="font-size: 22px; color: var(--dark-bg); margin: 0;"><i class="fas fa-tags" style="color: var(--primary-blue);"></i> Create New Monthly Offer Slider Banner</h3>
        <button onclick="document.getElementById('newOfferModal').style.display='none'" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #64748b;">&times;</button>
      </div>

      <form id="newOfferForm" action="/api/admin/offers" method="POST">
        <div style="margin-bottom: 15px;">
          <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Offer Heading / Title *</label>
          <input type="text" name="title" required placeholder="e.g. August Special: 25% Off + Complimentary Dinner" class="form-control-custom">
        </div>

        <div style="margin-bottom: 15px;">
          <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Subtitle / Offer Description *</label>
          <textarea name="subtitle" rows="2" required placeholder="Brief description of the offer for the slider banner..." class="form-control-custom"></textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 15px;">
          <div>
            <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Banner Image URL *</label>
            <input type="text" name="image" required value="/images/hotel-img-5.jpeg" placeholder="/images/hotel-img-5.jpeg" class="form-control-custom">
          </div>
          <div>
            <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Validity / Expiry Date</label>
            <input type="text" name="validity" value="Valid till 31st August 2026" placeholder="e.g. Valid till 31st August 2026" class="form-control-custom">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
          <div>
            <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Button Action Text *</label>
            <input type="text" name="btnText" required value="Claim Offer Now" placeholder="e.g. Claim Offer Now / Book Special" class="form-control-custom">
          </div>
          <div>
            <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Button Target Link *</label>
            <input type="text" name="btnLink" required value="/checkout?type=room" placeholder="e.g. /checkout?type=room or WhatsApp link" class="form-control-custom">
          </div>
        </div>

        <div style="display: flex; gap: 15px; justify-content: flex-end;">
          <button type="button" onclick="document.getElementById('newOfferModal').style.display='none'" class="btn-outline-blue">Cancel</button>
          <button type="submit" class="btn-blue"><i class="fas fa-save"></i> Publish Offer to Slider</button>
        </div>
      </form>

    </div>
  </div>

  <script>
    async function deleteOffer(id) {
      if (!confirm('Are you sure you want to delete this monthly offer from the slider?')) return;
      try {
        const res = await fetch(`/api/admin/offers/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert(data.message || 'Error deleting offer.');
        }
      } catch (err) {
        alert('Failed to delete offer.');
      }
    }
  </script>

</body>
</html>
