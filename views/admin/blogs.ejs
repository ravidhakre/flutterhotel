<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'CMS Blog Management | Flutter Hotels Admin' %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">

  <aside class="admin-sidebar">
    <div class="sidebar-header" style="display: flex; align-items: center; gap: 10px;">
      <img src="/images/logo.avif" alt="Logo" style="height: 35px; background: #fff; padding: 2px; border-radius: 4px;"> FLUTTER ADMIN
    </div>
    <ul class="sidebar-menu">
      <li><a href="/admin"><i class="fas fa-chart-line"></i> Dashboard</a></li>
      <li><a href="/admin/bookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
      <li><a href="/admin/rooms"><i class="fas fa-bed"></i> Room Inventory</a></li>
      <li><a href="/admin/offers"><i class="fas fa-tags"></i> Special Offers & Deals</a></li>
      <li><a href="/admin/blogs" class="active"><i class="fas fa-blog"></i> CMS Travel Blogs</a></li>
      <li><a href="/admin/inquiries"><i class="fas fa-envelope"></i> Customer Enquiries</a></li>
      <li style="margin-top: 40px;"><a href="/" target="_blank"><i class="fas fa-external-link-alt"></i> View Main Website</a></li>
      <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="admin-main">
    <header class="admin-topbar">
      <h2 style="margin: 0; font-size: 22px;">CMS Blog & Article Manager</h2>
      <button onclick="document.getElementById('newBlogModal').style.display='flex'" class="btn-admin btn-admin-primary">
        <i class="fas fa-plus"></i> Write & Design New Blog
      </button>
    </header>

    <div class="admin-content">
      
      <div style="background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.05); overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
          <thead>
            <tr style="background: #f1f5f9; color: #475569; font-size: 13px; text-transform: uppercase;">
              <th style="padding: 16px 20px;">Image</th>
              <th style="padding: 16px 20px;">Title & Slug</th>
              <th style="padding: 16px 20px;">Category</th>
              <th style="padding: 16px 20px;">Author</th>
              <th style="padding: 16px 20px;">Date</th>
              <th style="padding: 16px 20px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (blogs && blogs.length > 0) { %>
              <% blogs.forEach(function(blog) { %>
                <tr style="border-bottom: 1px solid #f1f5f9; font-size: 14px;">
                  <td style="padding: 15px 20px;">
                    <img src="<%= blog.image %>" alt="<%= blog.title %>" style="width: 60px; height: 45px; object-fit: cover; border-radius: 6px;">
                  </td>
                  <td style="padding: 15px 20px;">
                    <strong style="color: var(--dark-bg); display: block; font-size: 15px;"><%= blog.title %></strong>
                    <span style="font-size: 12px; color: #64748b;">/blog/<%= blog.slug %></span>
                  </td>
                  <td style="padding: 15px 20px;">
                    <span style="background: #e0f2fe; color: #0284c7; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: bold;">
                      <%= blog.category %>
                    </span>
                  </td>
                  <td style="padding: 15px 20px; color: #475569;"><%= blog.author %></td>
                  <td style="padding: 15px 20px; color: #475569;"><%= blog.date %></td>
                  <td style="padding: 15px 20px;">
                    <div style="display: flex; gap: 8px;">
                      <a href="/blog/<%= blog.slug %>" target="_blank" class="btn-outline-blue" style="padding: 6px 12px; font-size: 12px;" title="Preview"><i class="fas fa-eye"></i> View</a>
                      <button onclick="deleteBlog('<%= blog.id %>')" class="btn-blue" style="background: #ef4444 !important; border-color: #ef4444 !important; padding: 6px 12px; font-size: 12px;" title="Delete"><i class="fas fa-trash"></i> Delete</button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" style="padding: 30px; text-align: center; color: #64748b;">No blogs found. Click 'Write & Design New Blog' to create one.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </div>
  </main>

  <!-- Write & Design New Blog Modal -->
  <div id="newBlogModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 2000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #ffffff; width: 90%; max-width: 850px; max-height: 90vh; overflow-y: auto; border-radius: 12px; padding: 35px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);">
      
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 2px solid #f1f5f9; padding-bottom: 15px;">
        <h3 style="font-size: 22px; color: var(--dark-bg); margin: 0;"><i class="fas fa-pen-nib" style="color: var(--primary-blue);"></i> Write & Design New Blog Post</h3>
        <button onclick="document.getElementById('newBlogModal').style.display='none'" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #64748b;">&times;</button>
      </div>

      <form id="newBlogForm" action="/api/admin/blogs" method="POST">
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 15px;">
          <div>
            <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Blog Title *</label>
            <input type="text" name="title" required placeholder="e.g. Top 5 Viewpoints in Lansdowne" class="form-control-custom">
          </div>
          <div>
            <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Category *</label>
            <select name="category" class="form-control-custom">
              <option value="Travel & Sightseeing">Travel & Sightseeing</option>
              <option value="Weekend Trips">Weekend Trips</option>
              <option value="Weddings & Events">Weddings & Events</option>
              <option value="Food & Dining">Food & Dining</option>
              <option value="Resort Life">Resort Life</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div>
            <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Author Name</label>
            <input type="text" name="author" value="Flutter Editorial Team" class="form-control-custom">
          </div>
          <div>
            <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Cover Image URL</label>
            <input type="text" name="image" value="/images/hotel-img-1.jpg" class="form-control-custom">
          </div>
          <div>
            <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Read Time</label>
            <input type="text" name="readTime" value="5 min read" class="form-control-custom">
          </div>
        </div>

        <div style="margin-bottom: 15px;">
          <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">Short Summary / Excerpt *</label>
          <textarea name="excerpt" rows="2" required placeholder="Brief 2-line preview description of the article..." class="form-control-custom"></textarea>
        </div>

        <!-- Rich HTML Content Formatter -->
        <div style="margin-bottom: 20px;">
          <label style="font-size: 13px; font-weight: bold; display: block; margin-bottom: 6px;">
            Designed Article Content (HTML / Styled Text) *
          </label>
          <p style="font-size: 12px; color: #64748b; margin-top: -4px; margin-bottom: 8px;">
            Tip: You can use HTML tags like &lt;h2&gt;Heading&lt;/h2&gt;, &lt;p&gt;Paragraph&lt;/p&gt;, &lt;ul&gt;&lt;li&gt;Bullet&lt;/li&gt;&lt;/ul&gt;, and &lt;img src="..."&gt; to style your article.
          </p>
          <textarea name="content" rows="10" required placeholder="<h2>Article Subheading</h2><p>Write your detailed blog content here...</p>" class="form-control-custom" style="font-family: monospace; font-size: 13px;"></textarea>
        </div>

        <div style="display: flex; gap: 15px; justify-content: flex-end;">
          <button type="button" onclick="document.getElementById('newBlogModal').style.display='none'" class="btn-outline-blue">Cancel</button>
          <button type="submit" class="btn-blue"><i class="fas fa-paper-plane"></i> Publish Blog Post</button>
        </div>
      </form>

    </div>
  </div>

  <script>
    async function deleteBlog(id) {
      if (!confirm('Are you sure you want to delete this blog post?')) return;
      try {
        const res = await fetch(`/api/admin/blogs/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert(data.message || 'Error deleting blog.');
        }
      } catch (err) {
        alert('Failed to delete blog post.');
      }
    }
  </script>

</body>
</html>
