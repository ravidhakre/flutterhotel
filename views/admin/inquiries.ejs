<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Customer Inquiries | Hotux Admin' %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">

  <aside class="admin-sidebar">
    <div class="sidebar-header">
      <i class="fas fa-hotel"></i> HOTUX ADMIN
    </div>
    <ul class="sidebar-menu">
      <li><a href="/admin"><i class="fas fa-chart-line"></i> Dashboard</a></li>
      <li><a href="/admin/bookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
      <li><a href="/admin/rooms"><i class="fas fa-bed"></i> Room Inventory</a></li>
      <li><a href="/admin/inquiries" class="active"><i class="fas fa-envelope"></i> Customer Messages (<%= inquiries.length %>)</a></li>
      <li style="margin-top: 40px;"><a href="/"><i class="fas fa-external-link-alt"></i> View Main Website</a></li>
      <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <main class="admin-main">
    <header class="admin-topbar">
      <h2 style="margin: 0; font-size: 22px;">Customer Inquiries & Messages</h2>
    </header>

    <div class="admin-content">
      <div class="admin-card-table">
        <div class="card-header-flex">
          <h3 style="margin: 0; font-size: 18px;"><i class="fas fa-inbox" style="color: var(--admin-primary);"></i> Contact Form Inbox</h3>
        </div>

        <table class="table-custom">
          <thead>
            <tr>
              <th>Date</th>
              <th>Customer</th>
              <th>Subject</th>
              <th>Message</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% inquiries.forEach(inq => { %>
              <tr>
                <td><span style="font-size: 12px; color: #777;"><%= new Date(inq.date).toLocaleDateString() %></span></td>
                <td>
                  <strong><%= inq.name %></strong><br>
                  <span style="font-size: 11px; color: #666;"><%= inq.email %></span><br>
                  <span style="font-size: 11px; color: #888;"><%= inq.phone %></span>
                </td>
                <td><strong><%= inq.subject %></strong></td>
                <td style="max-width: 300px;"><p style="font-size: 13px; color: #444; margin: 0;"><%= inq.message %></p></td>
                <td>
                  <span class="badge-status <%= inq.status === 'Unread' ? 'badge-pending' : 'badge-confirmed' %>">
                    <%= inq.status %>
                  </span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script src="/js/admin.js"></script>
</body>
</html>
