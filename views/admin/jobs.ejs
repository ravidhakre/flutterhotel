<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">

  <!-- Sidebar -->
  <aside class="admin-sidebar">
    <div class="sidebar-header" style="display: flex; align-items: center; gap: 10px;">
      <img src="/images/logo.avif" alt="Logo" style="height: 35px; background: #fff; padding: 2px; border-radius: 4px;"> FLUTTER ADMIN
    </div>
    <ul class="sidebar-menu">
      <li><a href="/admin"><i class="fas fa-chart-line"></i> Dashboard</a></li>
      <li><a href="/admin/bookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
      <li><a href="/admin/rooms"><i class="fas fa-bed"></i> Room Inventory</a></li>
      <li><a href="/admin/inquiries"><i class="fas fa-envelope"></i> Customer Enquiries</a></li>
      <li><a href="/admin/blogs"><i class="fas fa-blog"></i> CMS Travel Blogs</a></li>
      <li><a href="/admin/offers"><i class="fas fa-tags"></i> CMS Offers & Deals</a></li>
      <li><a href="/admin/jobs" class="active"><i class="fas fa-briefcase"></i> Careers & Jobs</a></li>
      <li style="margin-top: 40px;"><a href="/"><i class="fas fa-external-link-alt"></i> View Main Website</a></li>
      <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </aside>

  <!-- Main Content Area -->
  <main class="admin-main">
    <!-- Top Bar -->
    <header class="admin-topbar">
      <h2 style="margin: 0; font-size: 22px;">Careers & Job Openings Management</h2>
      <button onclick="openModal('addJobModal')" class="btn-blue" style="padding: 10px 20px; font-weight: bold; border-radius: 8px;">
        <i class="fas fa-plus-circle"></i> Add New Job Posting
      </button>
    </header>

    <div class="admin-content" style="padding: 30px;">
      <p style="color: #64748b; font-size: 15px; margin-bottom: 25px;">
        Post, edit, and manage live job openings for Flutter Hotels & Resorts, Lansdowne. Candidates applying on the site will connect directly to WhatsApp.
      </p>

      <!-- Jobs Data Table -->
      <div style="background: #ffffff; border-radius: 14px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <table class="admin-table" style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background: #f8fafc; text-align: left; font-size: 13px; color: #475569; border-bottom: 1px solid #e2e8f0;">
              <th style="padding: 15px 20px;">Job Title</th>
              <th style="padding: 15px 20px;">Category</th>
              <th style="padding: 15px 20px;">Type & Exp</th>
              <th style="padding: 15px 20px;">Location</th>
              <th style="padding: 15px 20px;">WhatsApp Direct</th>
              <th style="padding: 15px 20px;">Status</th>
              <th style="padding: 15px 20px; text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (jobs && jobs.length > 0) { %>
              <% jobs.forEach(job => { %>
                <tr style="border-bottom: 1px solid #f1f5f9; font-size: 14px; color: #334155;">
                  <td style="padding: 16px 20px; font-weight: bold; color: var(--dark-bg);">
                    <%= job.title %>
                  </td>
                  <td style="padding: 16px 20px; color: #64748b;"><%= job.category || 'General' %></td>
                  <td style="padding: 16px 20px;">
                    <span style="background: #e0f2fe; color: #0284c7; padding: 3px 10px; border-radius: 12px; font-size: 12px; font-weight: bold;"><%= job.type %></span>
                    <br><small style="color: #64748b;"><%= job.experience %></small>
                  </td>
                  <td style="padding: 16px 20px; color: #64748b;"><%= job.location %></td>
                  <td style="padding: 16px 20px; color: #16a34a; font-weight: bold;">
                    <i class="fab fa-whatsapp"></i> +<%= job.whatsappNumber || '918929232740' %>
                  </td>
                  <td style="padding: 16px 20px;">
                    <span style="background: <%= job.status === 'Inactive' ? '#fee2e2' : '#dcfce7' %>; color: <%= job.status === 'Inactive' ? '#dc2626' : '#16a34a' %>; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: bold;">
                      <%= job.status || 'Active' %>
                    </span>
                  </td>
                  <td style="padding: 16px 20px; text-align: right;">
                    <button onclick="editJob(<%= JSON.stringify(job) %>)" style="background: #f1f5f9; color: #0284c7; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-weight: bold; margin-right: 6px;">
                      <i class="fas fa-edit"></i> Edit
                    </button>
                    <button onclick="deleteJob('<%= job.id %>')" style="background: #fee2e2; color: #dc2626; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-weight: bold;">
                      <i class="fas fa-trash"></i> Delete
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" style="padding: 40px; text-align: center; color: #94a3b8;">No job openings posted yet. Click "Add New Job Posting" to create one.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- Add Job Modal -->
  <div id="addJobModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 2000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #ffffff; width: 100%; max-width: 650px; padding: 30px; border-radius: 16px; box-shadow: 0 20px 50px rgba(0,0,0,0.2); max-height: 90vh; overflow-y: auto;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px;">
        <h3 style="margin: 0; font-size: 20px; color: var(--dark-bg); font-family: 'Cinzel', serif;">Post New Job Opening</h3>
        <span onclick="closeModal('addJobModal')" style="font-size: 24px; cursor: pointer; color: #64748b;">&times;</span>
      </div>

      <form action="/api/admin/jobs" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
        <div>
          <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Job Title *</label>
          <input type="text" name="title" required placeholder="e.g. Front Desk Executive / Chef" class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
          <div>
            <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Department / Category</label>
            <input type="text" name="category" placeholder="e.g. Front Desk / Culinary / Housekeeping" class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
          </div>
          <div>
            <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Employment Type</label>
            <select name="type" class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
              <option value="Full-Time" selected>Full-Time</option>
              <option value="Part-Time">Part-Time</option>
              <option value="Contract">Contract</option>
              <option value="Trainee">Trainee / Intern</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
          <div>
            <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Experience Required</label>
            <input type="text" name="experience" placeholder="e.g. 1 - 3 Years" class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
          </div>
          <div>
            <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">WhatsApp Apply Number</label>
            <input type="text" name="whatsappNumber" value="918929232740" class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
          </div>
        </div>

        <div>
          <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Location</label>
          <input type="text" name="location" value="Lansdowne, Uttarakhand" class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
        </div>

        <div>
          <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Job Description *</label>
          <textarea name="description" rows="3" required placeholder="Describe key roles and day-to-day responsibilities..." class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;"></textarea>
        </div>

        <div>
          <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Requirements & Qualifications</label>
          <textarea name="requirements" rows="3" placeholder="Key skills required, education, language requirements..." class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;"></textarea>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 15px;">
          <button type="button" onclick="closeModal('addJobModal')" style="padding: 10px 20px; background: #e2e8f0; color: #334155; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">Cancel</button>
          <button type="submit" class="btn-blue" style="padding: 10px 26px; border-radius: 8px; font-weight: bold;"><i class="fas fa-check"></i> Post Job Opening</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Job Modal -->
  <div id="editJobModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 2000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #ffffff; width: 100%; max-width: 650px; padding: 30px; border-radius: 16px; box-shadow: 0 20px 50px rgba(0,0,0,0.2); max-height: 90vh; overflow-y: auto;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px;">
        <h3 style="margin: 0; font-size: 20px; color: var(--dark-bg); font-family: 'Cinzel', serif;">Edit Job Opening</h3>
        <span onclick="closeModal('editJobModal')" style="font-size: 24px; cursor: pointer; color: #64748b;">&times;</span>
      </div>

      <form id="editJobForm" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
        <div>
          <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Job Title *</label>
          <input type="text" id="editTitle" name="title" required class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
          <div>
            <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Department / Category</label>
            <input type="text" id="editCategory" name="category" class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
          </div>
          <div>
            <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Employment Type</label>
            <select id="editType" name="type" class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
              <option value="Full-Time">Full-Time</option>
              <option value="Part-Time">Part-Time</option>
              <option value="Contract">Contract</option>
              <option value="Trainee">Trainee / Intern</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
          <div>
            <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Experience Required</label>
            <input type="text" id="editExperience" name="experience" class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
          </div>
          <div>
            <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">WhatsApp Apply Number</label>
            <input type="text" id="editWhatsappNumber" name="whatsappNumber" class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
          <div>
            <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Location</label>
            <input type="text" id="editLocation" name="location" class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
          </div>
          <div>
            <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Posting Status</label>
            <select id="editStatus" name="status" class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;">
              <option value="Active">Active</option>
              <option value="Inactive">Inactive / Closed</option>
            </select>
          </div>
        </div>

        <div>
          <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Job Description *</label>
          <textarea id="editDescription" name="description" rows="3" required class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;"></textarea>
        </div>

        <div>
          <label style="display: block; font-weight: bold; font-size: 13px; color: #334155; margin-bottom: 6px;">Requirements & Qualifications</label>
          <textarea id="editRequirements" name="requirements" rows="3" class="form-control-custom" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1;"></textarea>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 15px;">
          <button type="button" onclick="closeModal('editJobModal')" style="padding: 10px 20px; background: #e2e8f0; color: #334155; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">Cancel</button>
          <button type="submit" class="btn-blue" style="padding: 10px 26px; border-radius: 8px; font-weight: bold;"><i class="fas fa-save"></i> Save Job Updates</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openModal(id) {
      document.getElementById(id).style.display = 'flex';
    }
    function closeModal(id) {
      document.getElementById(id).style.display = 'none';
    }

    function editJob(job) {
      document.getElementById('editJobForm').action = '/api/admin/jobs/edit/' + job.id;
      document.getElementById('editTitle').value = job.title || '';
      document.getElementById('editCategory').value = job.category || '';
      document.getElementById('editType').value = job.type || 'Full-Time';
      document.getElementById('editExperience').value = job.experience || '';
      document.getElementById('editWhatsappNumber').value = job.whatsappNumber || '918929232740';
      document.getElementById('editLocation').value = job.location || 'Lansdowne, Uttarakhand';
      document.getElementById('editStatus').value = job.status || 'Active';
      document.getElementById('editDescription').value = job.description || '';
      document.getElementById('editRequirements').value = job.requirements || '';
      openModal('editJobModal');
    }

    async function deleteJob(id) {
      if (confirm('Are you sure you want to delete this job posting?')) {
        const res = await fetch('/api/admin/jobs/' + id, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert('Error: ' + data.message);
        }
      }
    }
  </script>
</body>
</html>
