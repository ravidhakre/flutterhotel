<%- include('partials/header') %>

<!-- Careers Hero Banner -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.85)), url('/images/about-hotel-banner.jpg');">
  <div class="container" style="max-width: 900px; position: relative; z-index: 2;">
    <span style="background: rgba(245, 158, 11, 0.25); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 6px 20px; border-radius: 30px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: inline-block; margin-bottom: 18px; backdrop-filter: blur(4px);">
      <i class="fas fa-briefcase"></i> Work With Us
    </span>
    <h1 style="font-size: 44px; margin-bottom: 14px; color: #ffffff; font-family: 'Cinzel', serif; line-height: 1.25;">Careers at Flutter Hotels & Resorts</h1>
    <p style="color: #cbd5e1; font-size: 16.5px; line-height: 1.7; max-width: 760px; margin: 0 auto 25px;">
      Join our passionate team of hospitality professionals in Lansdowne. Explore rewarding career opportunities in hotel management, front desk operations, culinary arts, housekeeping, and guest services.
    </p>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    
    <!-- Culture & Benefits Section -->
    <div style="text-align: center; max-width: 750px; margin: 0 auto 50px;">
      <span class="section-subtitle">Why Join Flutter Hotels?</span>
      <h2 class="section-title">Grow Your Career in Mountain Hospitality</h2>
      <p style="color: #64748b; font-size: 15px;">
        We believe in empowering our employees with continuous learning, competitive compensation, staff accommodation, and a warm, collaborative work environment.
      </p>
    </div>

    <!-- Benefits Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 25px; margin-bottom: 60px;">
      <div style="background: #ffffff; padding: 28px; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <i class="fas fa-chart-line" style="font-size: 28px; color: var(--primary-blue); margin-bottom: 15px;"></i>
        <h4 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Career Advancement</h4>
        <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">Regular training programs and internal promotion opportunities across resort departments.</p>
      </div>

      <div style="background: #ffffff; padding: 28px; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <i class="fas fa-house-chimney-user" style="font-size: 28px; color: #10b981; margin-bottom: 15px;"></i>
        <h4 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Staff Accommodation & Meals</h4>
        <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">On-site staff boarding facilities and daily nutritious meals provided by our culinary kitchen.</p>
      </div>

      <div style="background: #ffffff; padding: 28px; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <i class="fas fa-hand-holding-hand" style="font-size: 28px; color: #f59e0b; margin-bottom: 15px;"></i>
        <h4 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Supportive Workplace</h4>
        <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">A respectful, inclusive resort culture driven by teamwork, integrity, and mutual respect.</p>
      </div>
    </div>

    <!-- Current Openings Header -->
    <div style="text-align: center; max-width: 750px; margin: 0 auto 40px;">
      <span class="section-subtitle">Current Opportunities</span>
      <h2 class="section-title">Open Positions in Lansdowne</h2>
    </div>

    <!-- Open Positions List -->
    <div style="display: flex; flex-direction: column; gap: 20px; max-width: 850px; margin: 0 auto 60px;">
      
      <!-- Position 1 -->
      <div style="background: #ffffff; padding: 25px 30px; border-radius: 14px; border: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
        <div>
          <h4 style="font-size: 19px; color: var(--dark-bg); margin-bottom: 4px;">Front Desk Executive / Receptionist</h4>
          <span style="color: #64748b; font-size: 13.5px;"><i class="fas fa-location-dot" style="color: var(--primary-blue);"></i> Lansdowne, Uttarakhand | Full-Time</span>
        </div>
        <a href="mailto:sales@flutterhotel.com?subject=Application%20for%20Front%20Desk%20Executive" class="btn-blue" style="padding: 10px 22px; font-size: 13.5px; border-radius: 8px;"><i class="fas fa-paper-plane"></i> Apply Now</a>
      </div>

      <!-- Position 2 -->
      <div style="background: #ffffff; padding: 25px 30px; border-radius: 14px; border: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
        <div>
          <h4 style="font-size: 19px; color: var(--dark-bg); margin-bottom: 4px;">F&B Captain / Multi-Cuisine Chef</h4>
          <span style="color: #64748b; font-size: 13.5px;"><i class="fas fa-location-dot" style="color: var(--primary-blue);"></i> Lansdowne, Uttarakhand | Full-Time</span>
        </div>
        <a href="mailto:sales@flutterhotel.com?subject=Application%20for%20Chef%20/%20FB%20Captain" class="btn-blue" style="padding: 10px 22px; font-size: 13.5px; border-radius: 8px;"><i class="fas fa-paper-plane"></i> Apply Now</a>
      </div>

      <!-- Position 3 -->
      <div style="background: #ffffff; padding: 25px 30px; border-radius: 14px; border: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
        <div>
          <h4 style="font-size: 19px; color: var(--dark-bg); margin-bottom: 4px;">Housekeeping Supervisor</h4>
          <span style="color: #64748b; font-size: 13.5px;"><i class="fas fa-location-dot" style="color: var(--primary-blue);"></i> Lansdowne, Uttarakhand | Full-Time</span>
        </div>
        <a href="mailto:sales@flutterhotel.com?subject=Application%20for%20Housekeeping%20Supervisor" class="btn-blue" style="padding: 10px 22px; font-size: 13.5px; border-radius: 8px;"><i class="fas fa-paper-plane"></i> Apply Now</a>
      </div>

    </div>

    <!-- Resume Application Box -->
    <div style="background: linear-gradient(rgba(15, 23, 42, 0.88), rgba(15, 23, 42, 0.88)), url('/images/hotel-img-3.jpg'); background-size: cover; background-position: center; padding: 50px 30px; border-radius: 16px; text-align: center; color: #ffffff; max-width: 850px; margin: 0 auto; box-shadow: 0 10px 30px rgba(0,0,0,0.12);">
      <h3 style="font-size: 28px; color: #ffffff; margin-bottom: 12px; font-family: 'Cinzel', serif;">Don't See Your Ideal Role?</h3>
      <p style="color: #cbd5e1; font-size: 15.5px; max-width: 650px; margin: 0 auto 25px; line-height: 1.6;">
        We are always on the lookout for talented individuals. Email your updated Resume / CV to <strong>sales@flutterhotel.com</strong> with your area of interest.
      </p>
      <a href="mailto:sales@flutterhotel.com?subject=General%20Career%20Application" class="btn-blue pulsing-btn" style="padding: 14px 34px; font-size: 15px; font-weight: bold; border-radius: 8px;">
        <i class="fas fa-envelope"></i> Send Resume / CV
      </a>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
