<%- include('partials/header') %>

<!-- Careers Hero Banner -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.85)), url('/images/about-hotel-banner.jpg');">
  <div class="container" style="max-width: 900px; position: relative; z-index: 2;">
    <span style="background: rgba(245, 158, 11, 0.25); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 6px 20px; border-radius: 30px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: inline-block; margin-bottom: 18px; backdrop-filter: blur(4px);">
      <i class="fas fa-briefcase"></i> Work With Us
    </span>
    <h1 style="font-size: 44px; margin-bottom: 14px; color: #ffffff; font-family: 'Cinzel', serif; line-height: 1.25;">Careers at Flutter Hotels & Resorts</h1>
    <p style="color: #cbd5e1; font-size: 16.5px; line-height: 1.7; max-width: 760px; margin: 0 auto 25px;">
      Join our passionate team of hospitality professionals in Lansdowne. Explore rewarding career opportunities and apply directly via WhatsApp.
    </p>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    
    <!-- Culture & Benefits Section -->
    <div style="text-align: center; max-width: 750px; margin: 0 auto 50px;">
      <span class="section-subtitle">Why Join Flutter Hotels?</span>
      <h2 class="section-title">Grow Your Career in Mountain Hospitality</h2>
      <p style="color: #64748b; font-size: 15px;">
        We believe in empowering our employees with continuous learning, competitive compensation, staff accommodation, and a warm, collaborative work environment.
      </p>
    </div>

    <!-- Benefits Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 25px; margin-bottom: 60px;">
      <div style="background: #ffffff; padding: 28px; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <i class="fas fa-chart-line" style="font-size: 28px; color: var(--primary-blue); margin-bottom: 15px;"></i>
        <h4 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Career Advancement</h4>
        <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">Regular training programs and internal promotion opportunities across resort departments.</p>
      </div>

      <div style="background: #ffffff; padding: 28px; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <i class="fas fa-house-chimney-user" style="font-size: 28px; color: #10b981; margin-bottom: 15px;"></i>
        <h4 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Staff Accommodation & Meals</h4>
        <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">On-site staff boarding facilities and daily nutritious meals provided by our culinary kitchen.</p>
      </div>

      <div style="background: #ffffff; padding: 28px; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <i class="fas fa-hand-holding-hand" style="font-size: 28px; color: #f59e0b; margin-bottom: 15px;"></i>
        <h4 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Supportive Workplace</h4>
        <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">A respectful, inclusive resort culture driven by teamwork, integrity, and mutual respect.</p>
      </div>
    </div>

    <!-- Current Openings Header -->
    <div style="text-align: center; max-width: 750px; margin: 0 auto 40px;">
      <span class="section-subtitle">Current Openings</span>
      <h2 class="section-title">Open Positions in Lansdowne</h2>
    </div>

    <!-- Open Positions List -->
    <div style="display: flex; flex-direction: column; gap: 24px; max-width: 900px; margin: 0 auto 60px;">
      <% if (locals.jobs && jobs.length > 0) { %>
        <% jobs.forEach(job => { %>
          <div style="background: #ffffff; padding: 30px; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 6px 20px rgba(0,0,0,0.03); display: flex; flex-direction: column; gap: 15px;">
            
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid #f1f5f9; padding-bottom: 15px;">
              <div>
                <span style="background: #f1f5f9; color: var(--primary-blue); padding: 4px 12px; border-radius: 20px; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; display: inline-block; margin-bottom: 8px;">
                  <i class="fas fa-tag"></i> <%= job.category || 'Hospitality' %>
                </span>
                <h3 style="font-size: 22px; color: var(--dark-bg); margin: 0 0 6px; font-family: 'Cinzel', serif;"><%= job.title %></h3>
                <div style="display: flex; gap: 15px; flex-wrap: wrap; font-size: 13.5px; color: #64748b;">
                  <span><i class="fas fa-location-dot" style="color: var(--primary-blue);"></i> <%= job.location || 'Lansdowne, Uttarakhand' %></span>
                  <span><i class="fas fa-clock" style="color: var(--primary-blue);"></i> <%= job.type || 'Full-Time' %></span>
                  <span><i class="fas fa-briefcase" style="color: var(--primary-blue);"></i> Exp: <%= job.experience || '1-3 Yrs' %></span>
                </div>
              </div>

              <!-- Apply via WhatsApp CTA -->
              <div>
                <a href="https://wa.me/<%= job.whatsappNumber || '918929232740' %>?text=<%= encodeURIComponent('Hi, I am interested in applying for the ' + job.title + ' position at Flutter Hotels & Resorts.') %>" target="_blank" style="background: #25D366; color: #ffffff; padding: 12px 24px; border-radius: 8px; font-weight: bold; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.35); transition: transform 0.2s ease;">
                  <i class="fab fa-whatsapp" style="font-size: 19px;"></i> Apply Now via WhatsApp
                </a>
              </div>
            </div>

            <div>
              <h5 style="margin: 0 0 6px; font-size: 14px; color: #334155; font-weight: 700;">Job Description & Role Responsibilities:</h5>
              <p style="color: #64748b; font-size: 14.5px; line-height: 1.7; margin: 0 0 12px;"><%= job.description %></p>
              
              <% if (job.requirements) { %>
                <h5 style="margin: 0 0 6px; font-size: 14px; color: #334155; font-weight: 700;">Key Requirements & Qualifications:</h5>
                <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;"><%= job.requirements %></p>
              <% } %>
            </div>

          </div>
        <% }); %>
      <% } else { %>
        <div style="background: #ffffff; padding: 40px; border-radius: 16px; border: 1px solid #e2e8f0; text-align: center; color: #64748b;">
          <i class="fas fa-briefcase" style="font-size: 40px; color: #cbd5e1; margin-bottom: 15px; display: block;"></i>
          <h4 style="margin: 0 0 8px; font-size: 18px; color: var(--dark-bg);">No Active Openings Right Now</h4>
          <p style="margin: 0;">Feel free to send your resume directly via WhatsApp or email for upcoming vacancies.</p>
        </div>
      <% } %>
    </div>

    <!-- Resume Application Box -->
    <div style="background: linear-gradient(rgba(15, 23, 42, 0.88), rgba(15, 23, 42, 0.88)), url('/images/hotel-img-3.jpg'); background-size: cover; background-position: center; padding: 50px 30px; border-radius: 16px; text-align: center; color: #ffffff; max-width: 900px; margin: 0 auto; box-shadow: 0 10px 30px rgba(0,0,0,0.12);">
      <h3 style="font-size: 28px; color: #ffffff; margin-bottom: 12px; font-family: 'Cinzel', serif;">Direct Contact with Hiring Team</h3>
      <p style="color: #cbd5e1; font-size: 15.5px; max-width: 680px; margin: 0 auto 25px; line-height: 1.6;">
        Have questions about working at Flutter Hotels & Resorts? Connect directly with our management team on WhatsApp or send your updated CV.
      </p>
      <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
        <a href="https://wa.me/918929232740?text=Hi%2C%20I%20would%20like%20to%20apply%20for%20a%20career%20opportunity%20at%20Flutter%20Hotels%20%26%20Resorts." target="_blank" style="background: #25D366; color: #ffffff; padding: 14px 30px; font-weight: bold; font-size: 15px; border-radius: 8px; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);">
          <i class="fab fa-whatsapp" style="font-size: 20px;"></i> Chat on WhatsApp
        </a>
        <a href="mailto:sales@flutterhotel.com?subject=Career%20Application%20Resume" class="btn-outline-blue" style="padding: 14px 30px; font-weight: bold; font-size: 15px; border-radius: 8px; border-color: rgba(255,255,255,0.4); color: #fff; background: rgba(255,255,255,0.15); backdrop-filter: blur(4px);">
          <i class="fas fa-envelope"></i> Email Resume / CV
        </a>
      </div>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
