<%- include('partials/header') %>

<!-- Blog Catalog Hero Banner -->
<div style="background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.8)), url('/images/hotel-img-1.jpg') center/cover; padding: 70px 0; text-align: center; color: #fff;">
  <div class="container">
    <h1 style="font-size: 42px; margin-bottom: 10px; color: #ffffff;">Lansdowne Travel & Resort Stories</h1>
    <p style="color: var(--primary-blue); letter-spacing: 2px; text-transform: uppercase; font-weight: 600; font-size: 14px;">
      Travel Guides • Sightseeing Spots • Wedding Planning • Garhwal Himalayan Life
    </p>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc;">
  <div class="container">
    
    <div style="text-align: center; max-width: 700px; margin: 0 auto 50px;">
      <span class="section-subtitle">Official Flutter Blog</span>
      <h2 class="section-title">Latest Articles & Travel Insights</h2>
      <p style="color: var(--text-muted); font-size: 15px;">
        Explore expert travel tips, local Lansdowne attraction guides, and resort lifestyle updates from Flutter Hotels & Resorts.
      </p>
    </div>

    <!-- Blogs Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 30px;">
      <% blogs.forEach(function(article) { %>
        <div style="background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 8px 25px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; display: flex; flex-direction: column;">
          
          <div style="position: relative; height: 210px; overflow: hidden;">
            <img src="<%= article.image %>" alt="<%= article.title %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" class="blog-cover-img">
            <span style="position: absolute; top: 15px; right: 15px; background: var(--primary-blue); color: #fff; padding: 5px 14px; border-radius: 20px; font-size: 11px; font-weight: bold;">
              <%= article.category %>
            </span>
          </div>

          <div style="padding: 25px; flex-grow: 1; display: flex; flex-direction: column;">
            <div style="display: flex; gap: 15px; font-size: 12px; color: #64748b; margin-bottom: 10px;">
              <span><i class="far fa-calendar-alt" style="color: var(--primary-blue);"></i> <%= article.date %></span>
              <span><i class="far fa-clock" style="color: var(--primary-blue);"></i> <%= article.readTime || '5 min read' %></span>
            </div>

            <h3 style="font-size: 19px; color: var(--dark-bg); margin-bottom: 12px; line-height: 1.4;"><%= article.title %></h3>
            <p style="color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;">
              <%= article.excerpt %>
            </p>

            <a href="/blog/<%= article.slug %>" class="btn-outline-blue" style="font-size: 13px; text-align: center; display: block; padding: 10px;">
              Read Full Article <i class="fas fa-arrow-right"></i>
            </a>
          </div>

        </div>
      <% }); %>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
