<%- include('partials/header') %>

<!-- Facilities Hero Banner -->
<div style="background: linear-gradient(rgba(15, 23, 42, 0.82), rgba(15, 23, 42, 0.85)), url('/images/hotel-img-1.jpg') center/cover no-repeat; padding: 85px 0 65px; text-align: center; color: #fff;">
  <div class="container" style="max-width: 900px;">
    <span style="background: rgba(245, 158, 11, 0.25); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 5px 18px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: inline-block; margin-bottom: 15px;">
      Resort Amenities & Comfort
    </span>
    <h1 style="font-size: 42px; margin-bottom: 12px; color: #ffffff; font-family: 'Cinzel', serif;">Resort Facilities & Guest Amenities</h1>
    <p style="color: #cbd5e1; font-size: 16px; line-height: 1.7; max-width: 750px; margin: 0 auto;">
      Experience 5-star hospitality with multi-cuisine dining, manicured lawns, high-speed Wi-Fi, 24/7 concierge, and scenic mountain balconies.
    </p>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px;">
      <div style="background: #ffffff; padding: 30px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <i class="fas fa-utensils" style="font-size: 32px; color: var(--primary-blue); margin-bottom: 12px;"></i>
        <h3 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Multi-Cuisine Restaurant</h3>
        <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">Freshly prepared North Indian, Garhwali, Asian & Continental dining.</p>
      </div>

      <div style="background: #ffffff; padding: 30px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <i class="fas fa-wifi" style="font-size: 32px; color: #0284c7; margin-bottom: 12px;"></i>
        <h3 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">High-Speed Wi-Fi</h3>
        <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">Seamless fiber internet across all rooms, dining areas & resort lawns.</p>
      </div>

      <div style="background: #ffffff; padding: 30px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <i class="fas fa-square-parking" style="font-size: 32px; color: #22c55e; margin-bottom: 12px;"></i>
        <h3 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Secure On-Site Parking</h3>
        <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">Spacious private parking lot for cars, SUVs & Tempo Travellers.</p>
      </div>

      <div style="background: #ffffff; padding: 30px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <i class="fas fa-fire" style="font-size: 32px; color: #f59e0b; margin-bottom: 12px;"></i>
        <h3 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Evening Bonfire & Music</h3>
        <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">Nightly bonfire setups under starry mountain skies with light music.</p>
      </div>

      <div style="background: #ffffff; padding: 30px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <i class="fas fa-concierge-bell" style="font-size: 32px; color: #8b5cf6; margin-bottom: 12px;"></i>
        <h3 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">24/7 Room Service</h3>
        <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">Prompt in-room dining, daily housekeeping & travel desk assistance.</p>
      </div>

      <div style="background: #ffffff; padding: 30px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <i class="fas fa-gamepad" style="font-size: 32px; color: #ef4444; margin-bottom: 12px;"></i>
        <h3 style="font-size: 18px; color: var(--dark-bg); margin-bottom: 8px;">Recreation & Lawn Games</h3>
        <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">Badminton, carrom, chess, board games & kids play area.</p>
      </div>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
