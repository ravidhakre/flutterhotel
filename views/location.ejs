<%- include('partials/header') %>

<!-- Location Hero Banner -->
<div style="background: linear-gradient(rgba(15, 23, 42, 0.82), rgba(15, 23, 42, 0.85)), url('/images/valley-city-views.jpg') center/cover no-repeat; padding: 85px 0 65px; text-align: center; color: #fff;">
  <div class="container" style="max-width: 900px;">
    <span style="background: rgba(245, 158, 11, 0.25); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 5px 18px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: inline-block; margin-bottom: 15px;">
      Hillside Sanctuary
    </span>
    <h1 style="font-size: 42px; margin-bottom: 12px; color: #ffffff; font-family: 'Cinzel', serif;">How To Reach Flutter Hotels & Resorts</h1>
    <p style="color: #cbd5e1; font-size: 16px; line-height: 1.7; max-width: 750px; margin: 0 auto 25px;">
      Located at Palkot–Lansdowne, Garhwal, Uttarakhand (246155). Easily accessible by road from Delhi NCR (255 km), Kotdwar Railway Station (40 km), and Jolly Grant Airport Dehradun (145 km).
    </p>
    <a href="<%= mapEmbedUrl %>" target="_blank" class="btn-blue pulsing-btn" style="padding: 13px 30px; font-size: 14px; font-weight: bold;">
      <i class="fas fa-location-arrow"></i> Open Google Maps Navigation
    </a>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 50px;" class="responsive-two-col">
      <div>
        <h2 style="font-size: 26px; color: var(--dark-bg); margin-bottom: 20px;">Travel Routes & Distances</h2>
        
        <div style="display: flex; flex-direction: column; gap: 15px;">
          <div style="background: #ffffff; padding: 20px; border-radius: 10px; border: 1px solid #e2e8f0; display: flex; gap: 15px; align-items: center;">
            <i class="fas fa-car-side" style="font-size: 28px; color: var(--primary-blue);"></i>
            <div>
              <h4 style="font-size: 16px; margin-bottom: 2px;">By Road from Delhi NCR (255 km)</h4>
              <p style="color: #64748b; font-size: 13.5px; margin: 0;">Delhi → Meerut Expressway → Bijnor → Kotdwar → Palkot-Lansdowne (~5.5 Hours drive).</p>
            </div>
          </div>

          <div style="background: #ffffff; padding: 20px; border-radius: 10px; border: 1px solid #e2e8f0; display: flex; gap: 15px; align-items: center;">
            <i class="fas fa-train" style="font-size: 28px; color: #0284c7;"></i>
            <div>
              <h4 style="font-size: 16px; margin-bottom: 2px;">Nearest Railway Station — Kotdwar (KTW - 40 km)</h4>
              <p style="color: #64748b; font-size: 13.5px; margin: 0;">Daily trains from Delhi (Mussoorie Express & Siddhabali Jan Shatabdi). Taxi available outside station.</p>
            </div>
          </div>

          <div style="background: #ffffff; padding: 20px; border-radius: 10px; border: 1px solid #e2e8f0; display: flex; gap: 15px; align-items: center;">
            <i class="fas fa-plane-departure" style="font-size: 28px; color: #22c55e;"></i>
            <div>
              <h4 style="font-size: 16px; margin-bottom: 2px;">Nearest Airport — Jolly Grant Dehradun (DED - 145 km)</h4>
              <p style="color: #64748b; font-size: 13.5px; margin: 0;">Direct flights from Delhi, Mumbai, Bangalore & Hyderabad (~4 Hours scenic mountain taxi ride).</p>
            </div>
          </div>
        </div>
      </div>

      <div>
        <div style="background: #ffffff; border-radius: 14px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 8px 25px rgba(0,0,0,0.06); height: 100%; min-height: 380px;">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3460.5!2d78.68!3d29.84!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3909f18a287fa83d%3A0x6fb2a06bb72d2e1b!2sFlutter%20Hotels%20%26%20Resorts!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin" width="100%" height="100%" style="border:0; min-height: 380px;" allowfullscreen="" loading="lazy"></iframe>
        </div>
      </div>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
