<%- include('partials/header') %>

<!-- Hero Banner -->
<section class="hero-section">
  <div>
    <p class="hero-subtitle">Welcome to Hotux Resort</p>
    <h1 class="hero-title">Experience Unmatched Luxury & Serenity</h1>
    <a href="/rooms" class="btn-blue" style="font-size: 16px; padding: 14px 36px;"><i class="fas fa-bed"></i> Explore Our Rooms</a>
  </div>
</section>

<!-- Search / Check Availability Widget Bar -->
<div class="container booking-search-wrapper">
  <div class="booking-search-card">
    <form action="/rooms" method="GET" class="search-form-grid">
      <div class="form-group-custom">
        <label><i class="far fa-calendar-alt"></i> Check In</label>
        <input type="date" id="checkIn" name="checkIn" class="form-control-custom">
      </div>
      <div class="form-group-custom">
        <label><i class="far fa-calendar-alt"></i> Check Out</label>
        <input type="date" id="checkOut" name="checkOut" class="form-control-custom">
      </div>
      <div class="form-group-custom">
        <label><i class="fas fa-users"></i> Guests</label>
        <select name="guests" class="form-control-custom">
          <option value="1">1 Adult</option>
          <option value="2" selected>2 Adults</option>
          <option value="3">3 Adults</option>
          <option value="4">4+ Family</option>
        </select>
      </div>
      <div class="form-group-custom">
        <label><i class="fas fa-door-open"></i> Room Type</label>
        <select name="category" class="form-control-custom">
          <option value="All">All Categories</option>
          <option value="Deluxe">Deluxe</option>
          <option value="Suite">Suite</option>
          <option value="Presidential">Presidential</option>
          <option value="Villa">Villa</option>
        </select>
      </div>
      <div>
        <button type="submit" class="btn-blue" style="width: 100%; text-align: center; border: none; padding: 14px;"><i class="fas fa-search"></i> Search</button>
      </div>
    </form>
  </div>
</div>

<!-- About Section -->
<section class="section-padding">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center;">
      <div>
        <span class="section-subtitle" style="text-align: left;">Discover Hotux</span>
        <h2 class="section-title" style="text-align: left; font-size: 38px;">A 5-Star Haven of Comfort & Distinction</h2>
        <p style="color: var(--text-muted); margin-bottom: 20px; font-size: 15px;">
          Hotux Luxury Hotel & Resort is designed for travelers who seek unparalleled refinement, world-class hospitality, and pristine coastal vistas. From customized room amenities to bespoke culinary creations by our top international chefs, every moment at Hotux is crafted to perfection.
        </p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
          <div style="display: flex; gap: 12px; align-items: center;">
            <i class="fas fa-wifi" style="font-size: 24px; color: var(--primary-blue);"></i>
            <div>
              <h5 style="margin: 0; font-weight: 600; color: var(--dark-bg);">High-Speed Wi-Fi</h5>
              <span style="font-size: 13px; color: #777;">Complimentary 1Gbps</span>
            </div>
          </div>
          <div style="display: flex; gap: 12px; align-items: center;">
            <i class="fas fa-utensils" style="font-size: 24px; color: var(--primary-blue);"></i>
            <div>
              <h5 style="margin: 0; font-weight: 600; color: var(--dark-bg);">Fine Dining</h5>
              <span style="font-size: 13px; color: #777;">24/7 Room Service</span>
            </div>
          </div>
          <div style="display: flex; gap: 12px; align-items: center;">
            <i class="fas fa-spa" style="font-size: 24px; color: var(--primary-blue);"></i>
            <div>
              <h5 style="margin: 0; font-weight: 600; color: var(--dark-bg);">Luxury Spa</h5>
              <span style="font-size: 13px; color: #777;">Wellness Therapy</span>
            </div>
          </div>
          <div style="display: flex; gap: 12px; align-items: center;">
            <i class="fas fa-swimming-pool" style="font-size: 24px; color: var(--primary-blue);"></i>
            <div>
              <h5 style="margin: 0; font-weight: 600; color: var(--dark-bg);">Infinity Pool</h5>
              <span style="font-size: 13px; color: #777;">Sunset Ocean Views</span>
            </div>
          </div>
        </div>
        <a href="/contact" class="btn-outline-blue">Learn More About Us</a>
      </div>
      <div>
        <img src="/images/room-1.jpg" alt="Hotux Resort Suite" style="width: 100%; border-radius: 10px; box-shadow: var(--shadow-lg);">
      </div>
    </div>
  </div>
</section>

<!-- Featured Rooms Section -->
<section class="section-padding" style="background: var(--light-bg);">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">Luxury Accommodations</span>
      <h2 class="section-title">Explore Our Premier Rooms & Suites</h2>
      <div class="title-line-divider"></div>
    </div>

    <div class="rooms-grid">
      <% featuredRooms.forEach(room => { %>
        <div class="room-card">
          <div class="room-img-wrap">
            <img src="<%= room.image %>" alt="<%= room.name %>">
            <div class="room-price-badge">$<%= room.price %> <span style="font-size: 12px; font-family: var(--font-sans);">/ Night</span></div>
          </div>
          <div class="room-card-body">
            <h3 class="room-title"><%= room.name %></h3>
            <div class="room-specs">
              <span><i class="fas fa-bed"></i> <%= room.bed %></span>
              <span><i class="fas fa-users"></i> Up to <%= room.capacity %> Guests</span>
              <span><i class="fas fa-ruler-combined"></i> <%= room.size %></span>
            </div>
            <p class="room-desc"><%= room.description %></p>
            <div class="room-card-footer">
              <a href="/rooms/<%= room.id %>" class="btn-outline-blue" style="padding: 8px 18px; font-size: 13px;">View Details</a>
              <a href="/rooms/<%= room.id %>" class="btn-blue" style="padding: 8px 18px; font-size: 13px;">Book Now</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Parallax Feature Banner -->
<section class="parallax-banner">
  <div class="container">
    <span class="hero-subtitle">Exclusive Offers</span>
    <h2 style="font-size: 42px; margin-bottom: 20px; color: #ffffff;">Book Direct & Receive 20% Off Your Luxury Stay</h2>
    <p style="max-width: 700px; margin: 0 auto 30px; font-size: 16px; color: #e2e8f0;">
      Enjoy complimentary airport luxury transfers, gourmet breakfast buffets, and $100 spa credits when you reserve your suite directly with Hotux Hotel.
    </p>
    <a href="/rooms" class="btn-blue" style="font-size: 16px; padding: 14px 36px;">Reserve Your Room Today</a>
  </div>
</section>

<!-- Hotel Services Showcase -->
<section class="section-padding">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">World-Class Facilities</span>
      <h2 class="section-title">Explore Our Hotel Services</h2>
      <div class="title-line-divider"></div>
    </div>

    <div class="services-grid">
      <div class="service-card">
        <div class="service-icon"><i class="fas fa-utensils"></i></div>
        <h4>Fine Dining Restaurant</h4>
        <p style="font-size: 14px; color: var(--text-muted);">Savor Michelin-inspired international cuisines prepared by executive master chefs daily.</p>
      </div>

      <div class="service-card">
        <div class="service-icon"><i class="fas fa-spa"></i></div>
        <h4>Spa & Massage Sanctuary</h4>
        <p style="font-size: 14px; color: var(--text-muted);">Rejuvenate your mind, body, and spirit with organic essential oil treatments and massages.</p>
      </div>

      <div class="service-card">
        <div class="service-icon"><i class="fas fa-glass-cheers"></i></div>
        <h4>Events & Conference Center</h4>
        <p style="font-size: 14px; color: var(--text-muted);">Host unforgettable weddings, executive conferences, and private banquets with state-of-the-art tech.</p>
      </div>

      <div class="service-card">
        <div class="service-icon"><i class="fas fa-swimming-pool"></i></div>
        <h4>Infinity Sunset Pool</h4>
        <p style="font-size: 14px; color: var(--text-muted);">Relax in temperature-controlled oceanfront swimming pools with complimentary cocktail service.</p>
      </div>
    </div>
  </div>
</section>

<!-- Customer Reviews Section -->
<section class="section-padding" style="background: var(--light-bg);">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">Guest Experience</span>
      <h2 class="section-title">What Our Guests Say About Us</h2>
      <div class="title-line-divider"></div>
    </div>

    <div class="reviews-grid">
      <% reviews.forEach(review => { %>
        <div class="review-card">
          <div class="review-stars">
            <% for(let i=0; i<review.rating; i++) { %>
              <i class="fas fa-star"></i>
            <% } %>
          </div>
          <p class="review-text">"<%= review.text %>"</p>
          <div class="review-author"><%= review.author %> - <span style="font-weight: 400; color: #888;"><%= review.location %></span></div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
