<%- include('partials/header') %>

<!-- Hero Video Background Header Section -->
<section class="hero-video-section">
  <video autoplay muted loop playsinline class="hero-video-bg">
    <source src="/images/video.mp4" type="video/mp4">
  </video>
  <div class="hero-video-overlay"></div>
</section>

<!-- Check Availability Widget Bar -->
<div class="container booking-search-wrapper" id="searchWidget">
  <div class="booking-search-card">
    <form action="/rooms" method="GET" class="search-form-grid">
      <div class="form-group-custom">
        <label><i class="far fa-calendar-alt"></i> Check In <span style="font-size: 10px; color: #777; font-weight: normal;">(From 12:00 PM)</span></label>
        <input type="date" id="checkIn" name="checkIn" class="form-control-custom">
      </div>
      <div class="form-group-custom">
        <label><i class="far fa-calendar-alt"></i> Check Out <span style="font-size: 10px; color: #777; font-weight: normal;">(By 10:00 AM)</span></label>
        <input type="date" id="checkOut" name="checkOut" class="form-control-custom">
      </div>
      <div class="form-group-custom">
        <label><i class="fas fa-users"></i> Guests</label>
        <select name="guests" class="form-control-custom">
          <option value="1">1 Guest</option>
          <option value="2" selected>2 Guests</option>
          <option value="3">3 Guests</option>
          <option value="4">4+ Family</option>
        </select>
      </div>
      <div class="form-group-custom">
        <label><i class="fas fa-door-open"></i> Room Type</label>
        <select name="category" class="form-control-custom">
          <option value="All">All Rooms</option>
          <option value="Super Deluxe">Super Deluxe</option>
          <option value="Classic">Classic Valley</option>
        </select>
      </div>
      <div>
        <button type="submit" class="btn-blue search-btn-submit" style="width: 100%; text-align: center; border: none; padding: 14px;"><i class="fas fa-search"></i> Check Availability</button>
      </div>
    </form>
  </div>
</div>

<!-- Trust Strip -->
<div class="trust-strip">
  <div class="container">
    <div class="trust-strip-grid">
      <div class="trust-item">
        <i class="fas fa-mountain"></i>
        <span><strong>32,400 sq. ft.</strong> Hillside Property in Garhwal Himalayas</span>
      </div>
      <div class="trust-item">
        <i class="fas fa-award"></i>
        <span>Independently Owned & Run — Established <strong>15 April 2023</strong></span>
      </div>
      <div class="trust-item">
        <i class="fas fa-fire"></i>
        <span>Multi-Cuisine Restaurant & <strong>200-Guest Banquet Hall</strong> with Bonfire & DJ Evenings</span>
      </div>
      <div class="trust-item">
        <i class="fas fa-wifi"></i>
        <span><strong>Free High-Speed Wi-Fi</strong> & Private Balcony in Every Room</span>
      </div>
    </div>
  </div>
</div>

<!-- Why Choose Flutter Section -->
<section class="section-padding">
  <div class="container">
    <div class="responsive-two-col" style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center;">
      <div>
        <span class="section-subtitle" style="text-align: left;">Why Choose Flutter</span>
        <h2 class="section-title" style="text-align: left; font-size: 36px;">A Hillside Stay Built Around Real Comforts</h2>
        <p style="color: var(--text-muted); margin-bottom: 25px; font-size: 15px; line-height: 1.8;">
          Here’s exactly what you get when you book directly with <strong>Flutter Hotels & Resorts</strong> in Lansdowne:
        </p>
        
        <div style="display: grid; grid-template-columns: 1fr; gap: 15px; margin-bottom: 30px;">
          <div style="display: flex; gap: 14px; align-items: flex-start;">
            <i class="fas fa-check-circle" style="font-size: 20px; color: var(--primary-blue); margin-top: 3px;"></i>
            <div>
              <h5 style="margin: 0; font-weight: 600; font-size: 16px;">Private Balconies</h5>
              <span style="font-size: 14px; color: var(--text-muted);">Private balconies in every room, most with valley views over the Garhwal hills.</span>
            </div>
          </div>
          <div style="display: flex; gap: 14px; align-items: flex-start;">
            <i class="fas fa-utensils" style="font-size: 20px; color: var(--primary-blue); margin-top: 3px;"></i>
            <div>
              <h5 style="margin: 0; font-weight: 600; font-size: 16px;">On-Site Multi-Cuisine Dining</h5>
              <span style="font-size: 14px; color: var(--text-muted);">Freshly prepared multi-cuisine breakfast, lunch, and dinner.</span>
            </div>
          </div>
          <div style="display: flex; gap: 14px; align-items: flex-start;">
            <i class="fas fa-fire" style="font-size: 20px; color: var(--primary-blue); margin-top: 3px;"></i>
            <div>
              <h5 style="margin: 0; font-weight: 600; font-size: 16px;">Bonfire & DJ Evenings</h5>
              <span style="font-size: 14px; color: var(--text-muted);">Outdoor lawns strung with fairy lights — ideal for groups, celebrations, and reunions.</span>
            </div>
          </div>
          <div style="display: flex; gap: 14px; align-items: flex-start;">
            <i class="fas fa-users" style="font-size: 20px; color: var(--primary-blue); margin-top: 3px;"></i>
            <div>
              <h5 style="margin: 0; font-weight: 600; font-size: 16px;">Banquet Hall for 200 Guests</h5>
              <span style="font-size: 14px; color: var(--text-muted);">Perfect for weddings, corporate offsites, and family functions.</span>
            </div>
          </div>
          <div style="display: flex; gap: 14px; align-items: flex-start;">
            <i class="fas fa-gamepad" style="font-size: 20px; color: var(--primary-blue); margin-top: 3px;"></i>
            <div>
              <h5 style="margin: 0; font-weight: 600; font-size: 16px;">Indoor Games & Kids Play Zone</h5>
              <span style="font-size: 14px; color: var(--text-muted);">Dedicated recreation space for family stays and children.</span>
            </div>
          </div>
        </div>

        <a href="/contact" class="btn-outline-blue">Contact Our Concierge</a>
      </div>

      <div>
        <img src="/images/hotel-img-3.jpg" alt="Flutter Hotels Lawns and Resort View" style="width: 100%; border-radius: 12px; box-shadow: var(--shadow-lg);">
      </div>
    </div>
  </div>
</section>

<!-- Luxury Rooms Teaser Section -->
<section class="section-padding" style="background: var(--light-bg);">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">Luxury Accommodations</span>
      <h2 class="section-title">Suites Built Around Himalayan Views</h2>
      <p style="color: var(--text-muted);">Three distinct room categories, each offering a private balcony, king bed, and panoramic Garhwal views.</p>
      <div class="title-line-divider" style="margin-top: 15px;"></div>
    </div>

    <div class="luxury-rooms-grid">
      <% rooms.forEach((room, idx) => { %>
        <div class="luxury-room-card">
          <div class="room-img-container">
            <img src="<%= room.image %>" alt="<%= room.name %>" class="room-img">
            
            <!-- Category Tag -->
            <span class="room-tag-badge">
              <% if (idx === 0) { %><i class="fas fa-crown"></i> Most Popular<% } else if (idx === 1) { %><i class="fas fa-tree"></i> Resort Lawns<% } else { %><i class="fas fa-gem"></i> Best Value<% } %>
            </span>

            <!-- Price Tag Overlay -->
            <div class="room-price-overlay">
              <span class="price-val">₹<%= room.price.toLocaleString() %></span>
              <span class="price-unit">/ Night</span>
            </div>
          </div>

          <div class="room-card-content">
            <h3 class="luxury-room-title"><%= room.name %></h3>

            <!-- Specs Grid Pills -->
            <div class="specs-pills-row">
              <div class="spec-pill"><i class="fas fa-bed"></i> <%= room.bed %></div>
              <div class="spec-pill"><i class="fas fa-vector-square"></i> <%= room.size %></div>
              <div class="spec-pill"><i class="fas fa-mountain"></i> <%= room.view %></div>
            </div>

            <p class="luxury-room-desc"><%= room.description %></p>

            <!-- Amenities Quick Bar -->
            <div class="amenities-quick-bar">
              <span><i class="fas fa-wifi"></i> Free Wi-Fi</span>
              <span><i class="fas fa-mug-hot"></i> Coffee Maker</span>
              <span><i class="fas fa-tv"></i> 32" TV</span>
              <span><i class="fas fa-door-open"></i> Private Balcony</span>
            </div>

            <!-- Card Actions -->
            <div class="room-action-footer">
              <a href="/rooms/<%= room.id %>" class="btn-card-outline"><i class="fas fa-circle-info"></i> Specs & FAQs</a>
              <a href="/rooms/<%= room.id %>" class="btn-card-primary"><i class="fas fa-calendar-check"></i> Book Room</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <div style="text-align: center; margin-top: 50px;">
      <a href="/rooms" class="btn-blue" style="padding: 14px 38px; font-size: 15px;"><i class="fas fa-layer-group"></i> View All Accommodations & Pricing</a>
    </div>
  </div>
</section>

<!-- Offers & Packages Banner -->
<section class="parallax-banner">
  <div class="container">
    <span class="hero-subtitle">Special Packages</span>
    <h2 style="font-size: 40px; margin-bottom: 20px; color: #ffffff;">Save on Your Stay with Our Direct Offers</h2>
    <p style="max-width: 750px; margin: 0 auto 30px; font-size: 16px; color: #e2e8f0;">
      From 20% off weekday stays with a free dinner included, to our <strong>₹4,999/person 2N/3D group departure</strong> from Delhi — there’s a package for every kind of trip to Lansdowne.
    </p>
    <a href="/offers" class="btn-blue" style="font-size: 16px; padding: 14px 36px;"><i class="fas fa-tags"></i> View All Offers & Packages</a>
  </div>
</section>

<!-- Guest Reviews Section -->
<section class="section-padding">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">Guest Reviews</span>
      <h2 class="section-title">What Our Guests Say</h2>
      <p style="color: var(--text-muted);">
        Flutter Hotels & Resorts opened in April 2023 — here’s what our guests have said about their stay with us in Lansdowne.
      </p>
      <div class="title-line-divider" style="margin-top: 15px;"></div>
    </div>

    <div class="reviews-grid">
      <% reviews.forEach(review => { %>
        <div class="review-card">
          <div class="review-stars">
            <% for(let i=0; i<review.rating; i++) { %>
              <i class="fas fa-star"></i>
            <% } %>
          </div>
          <p class="review-text">"<%= review.text %>"</p>
          <div class="review-author"><%= review.author %> — <span style="font-weight: 400; color: #888;"><%= review.location %></span></div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Things To Do Teaser -->
<section class="section-padding" style="background: var(--light-bg);">
  <div class="container">
    <div class="responsive-two-col" style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center;">
      <div>
        <img src="/images/hotel-img-4.jpeg" alt="Lansdowne Sightseeing" style="width: 100%; border-radius: 12px; box-shadow: var(--shadow-lg);">
      </div>
      <div>
        <span class="section-subtitle" style="text-align: left;">Explore Lansdowne</span>
        <h2 class="section-title" style="text-align: left; font-size: 36px;">More Than Just a Place to Stay</h2>
        <p style="color: var(--text-muted); margin-bottom: 20px; font-size: 15px; line-height: 1.8;">
          Step outside and explore Tarkeshwar Mahadev Temple, watch sunrise from Tip-in-Top Point, or spend an afternoon boating on Bhulla Tal Lake — all within easy reach of the resort.
        </p>
        <a href="/things-to-do" class="btn-blue"><i class="fas fa-map-marked-alt"></i> Explore Things To Do</a>
      </div>
    </div>
  </div>
</section>

<!-- Celebrations / Events Teaser -->
<section class="section-padding">
  <div class="container">
    <div style="background: var(--dark-bg); color: #ffffff; padding: 60px 40px; border-radius: 16px; text-align: center; background-image: linear-gradient(rgba(26, 38, 56, 0.88), rgba(26, 38, 56, 0.88)), url('/images/hotel-img-8.jpg'); background-size: cover; background-position: center;">
      <span style="color: var(--primary-blue); text-transform: uppercase; letter-spacing: 3px; font-weight: 600; font-size: 14px;">Events & Weddings</span>
      <h2 style="font-size: 38px; color: #ffffff; margin: 10px 0 15px;">Celebrate Your Big Day With Us</h2>
      <p style="max-width: 750px; margin: 0 auto 30px; color: #cbd5e1; font-size: 16px;">
        Our banquet hall seats up to <strong>200 guests</strong>, and our outdoor lawns with fairy lights set the scene for weddings, birthdays, anniversaries and reunions — with catering handled in-house by our multi-cuisine restaurant.
      </p>
      <a href="/offers/wedding-celebration-package" class="btn-blue" style="padding: 14px 36px; font-size: 16px;"><i class="fas fa-glass-cheers"></i> Plan Your Celebration</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
