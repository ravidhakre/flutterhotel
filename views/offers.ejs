<%- include('partials/header') %>

<!-- Full-Width Top Offer Banner Slider -->
<% if (offers && offers.length > 0) { %>
  <div class="offers-fullslider-wrapper" id="offerSliderContainer">
    
    <div id="offerSliderTrack" class="offers-fullslider-track">
      <% offers.forEach(function(offer, idx) { %>
        <div class="offer-fullslide-item" style="background-image: linear-gradient(to top, rgba(15, 23, 42, 0.95) 0%, rgba(15, 23, 42, 0.55) 50%, rgba(15, 23, 42, 0.3) 100%), url('<%= offer.image %>');">
          
          <div class="container offer-fullslide-content">
            
            <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 15px;">
              <span class="offer-slide-badge">
                <i class="fas fa-tags"></i> <%= offer.tag || 'Special Offer' %>
              </span>
              <span class="offer-slide-price-pill">
                <i class="fas fa-bolt"></i> <%= offer.price %>
              </span>
            </div>
            
            <h1 class="offer-slide-title"><%= offer.title %></h1>
            
            <div class="offer-slide-actions">
              <a href="/offers/<%= offer.slug %>" class="btn-blue pulsing-btn" style="padding: 14px 32px; font-size: 15px; font-weight: bold; border-radius: 30px;">
                <i class="fas fa-eye"></i> View Offer Details
              </a>
              <a href="/checkout?type=offer&id=<%= offer.id %>" class="btn-outline-blue" style="padding: 14px 28px; font-size: 15px; font-weight: bold; border-radius: 30px; background: rgba(255,255,255,0.15); border-color: #ffffff; color: #ffffff;">
                <i class="fas fa-calendar-check"></i> Book Online
              </a>
            </div>

          </div>

        </div>
      <% }); %>
    </div>

    <!-- Slider Navigation Buttons -->
    <% if (offers.length > 1) { %>
      <button id="offerPrevBtn" class="offers-slider-nav-btn prev-btn" aria-label="Previous Offer">
        <i class="fas fa-chevron-left"></i>
      </button>
      <button id="offerNextBtn" class="offers-slider-nav-btn next-btn" aria-label="Next Offer">
        <i class="fas fa-chevron-right"></i>
      </button>
    <% } %>

  </div>
<% } %>

<!-- All Offers Catalog Grid -->
<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    
    <div style="text-align: center; margin-bottom: 40px;">
      <span class="section-subtitle">All Active Promotions</span>
      <h2 class="section-title">Explore Monthly Deals & Experiences</h2>
      <p style="color: #64748b; font-size: 15px; max-width: 650px; margin: 0 auto;">
        Choose from our handcrafted midweek specials, weekend getaways, and all-inclusive group departures at Flutter Hotels & Resorts, Lansdowne.
      </p>
    </div>

    <% if (offers && offers.length > 0) { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
        <% offers.forEach(function(offer) { %>
          <div style="background: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 8px 25px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; display: flex; flex-direction: column;">
            
            <div style="position: relative; height: 210px; overflow: hidden;">
              <img src="<%= offer.image %>" alt="<%= offer.title %>" style="width: 100%; height: 100%; object-fit: cover;">
              <span style="position: absolute; top: 15px; right: 15px; background: #0284c7; color: #fff; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: bold;">
                <%= offer.tag || 'Special Offer' %>
              </span>
              <span style="position: absolute; bottom: 15px; left: 15px; background: rgba(15, 23, 42, 0.85); color: #f59e0b; padding: 4px 12px; border-radius: 6px; font-size: 13px; font-weight: bold;">
                <%= offer.price %>
              </span>
            </div>
            
            <div style="padding: 25px; flex-grow: 1; display: flex; flex-direction: column;">
              <span style="color: #166534; font-size: 12px; font-weight: bold; text-transform: uppercase; margin-bottom: 8px;">
                <i class="fas fa-clock"></i> <%= offer.validity || 'Monthly Deal' %>
              </span>

              <h3 style="font-size: 19px; color: var(--dark-bg); margin-bottom: 10px; line-height: 1.4;"><%= offer.title %></h3>
              <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;">
                <%= offer.subtitle || offer.shortDesc %>
              </p>

              <div style="display: flex; gap: 10px;">
                <a href="/offers/<%= offer.slug %>" class="btn-blue" style="text-align: center; width: 100%; padding: 12px; font-size: 13.5px; font-weight: bold;">
                  <i class="fas fa-eye"></i> View Details
                </a>
              </div>
            </div>

          </div>
        <% }); %>
      </div>
    <% } %>

  </div>
</section>

<!-- Offer Slider JS -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('offerSliderTrack');
    const prevBtn = document.getElementById('offerPrevBtn');
    const nextBtn = document.getElementById('offerNextBtn');
    const slides = document.querySelectorAll('.offer-fullslide-item');
    
    if (slides.length > 1) {
      let currentIndex = 0;
      let sliderTimer = null;

      function updateSlide(index) {
        if (index >= slides.length) currentIndex = 0;
        else if (index < 0) currentIndex = slides.length - 1;
        else currentIndex = index;
        
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }

      function startAutoPlay() {
        stopAutoPlay();
        sliderTimer = setInterval(() => updateSlide(currentIndex + 1), 5000);
      }

      function stopAutoPlay() {
        if (sliderTimer) clearInterval(sliderTimer);
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          updateSlide(currentIndex + 1);
          startAutoPlay();
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          updateSlide(currentIndex - 1);
          startAutoPlay();
        });
      }

      const container = document.getElementById('offerSliderContainer');
      if (container) {
        container.addEventListener('mouseenter', stopAutoPlay);
        container.addEventListener('mouseleave', startAutoPlay);
      }

      startAutoPlay();
    }
  });
</script>

<%- include('partials/footer') %>
