<%- include('partials/header') %>

<!-- Blog Article Hero Header -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.8)), url('<%= article.image %>');">
  <div class="container" style="max-width: 800px;">
    <span style="background: var(--primary-blue); color: #fff; padding: 5px 16px; border-radius: 20px; font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 1.5px; display: inline-block; margin-bottom: 15px;">
      <%= article.category %>
    </span>
    <h1 style="font-size: 38px; margin-bottom: 15px; color: #ffffff; line-height: 1.3;"><%= article.title %></h1>
    <div style="display: flex; gap: 20px; justify-content: center; font-size: 14px; color: #cbd5e1;">
      <span><i class="fas fa-user-edit" style="color: var(--primary-blue);"></i> <%= article.author %></span>
      <span><i class="far fa-calendar-alt" style="color: var(--primary-blue);"></i> <%= article.date %></span>
      <span><i class="far fa-clock" style="color: var(--primary-blue);"></i> <%= article.readTime || '5 min read' %></span>
    </div>
  </div>
</div>

<section class="section-padding" style="background: #ffffff;">
  <div class="container" style="max-width: 820px;">
    
    <!-- Article Excerpt Lead -->
    <div style="background: #f8fafc; border-left: 4px solid var(--primary-blue); padding: 22px; border-radius: 8px; font-size: 17px; color: #334155; font-style: italic; line-height: 1.7; margin-bottom: 35px;">
      "<%= article.excerpt %>"
    </div>

    <!-- Article Rich Body Content -->
    <div class="blog-content-body" style="font-size: 16px; color: #334155; line-height: 1.8; margin-bottom: 50px;">
      <%- article.content %>
    </div>

    <hr style="margin: 40px 0; border: none; border-top: 1px solid #e2e8f0;">

    <!-- Share & Author Box -->
    <div style="background: #f8fafc; padding: 25px; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
      <div>
        <h4 style="font-size: 16px; color: var(--dark-bg); margin-bottom: 4px;">Written by <%= article.author %></h4>
        <p style="color: #64748b; font-size: 13px; margin: 0;">Official Editorial Publication of Flutter Hotels & Resorts, Lansdowne</p>
      </div>
      <div>
        <a href="https://wa.me/?text=Check%20out%20this%20article:%20<%= encodeURIComponent(article.title) %>" target="_blank" class="btn-blue" style="background: #25d366 !important; border-color: #25d366 !important; padding: 10px 20px; font-size: 13px;">
          <i class="fab fa-whatsapp"></i> Share Article
        </a>
      </div>
    </div>

    <div style="margin-top: 30px; text-align: center;">
      <a href="/blog" class="btn-outline-blue"><i class="fas fa-arrow-left"></i> Back to All Articles</a>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
