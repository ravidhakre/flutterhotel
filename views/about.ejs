<%- include('partials/header') %>

<!-- About Us Hero Banner (Full-Height Mobile Responsive) -->
<div class="page-hero-header" style="background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.85)), url('/images/hotel-img-8.jpg');">
  <div class="container" style="max-width: 900px; position: relative; z-index: 2;">
    <span style="background: rgba(245, 158, 11, 0.25); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 6px 20px; border-radius: 30px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: inline-block; margin-bottom: 18px; backdrop-filter: blur(4px);">
      <i class="fas fa-hotel"></i> Our Story & Legacy
    </span>
    <h1 style="font-size: 44px; margin-bottom: 14px; color: #ffffff; font-family: 'Cinzel', serif; line-height: 1.25;">About Flutter Hotels & Resorts, Lansdowne</h1>
    <p style="color: #cbd5e1; font-size: 16.5px; line-height: 1.7; max-width: 760px; margin: 0 auto 25px;">
      Welcome to Flutter Hotels & Resorts, a beautiful 32,400 sq. ft. hillside hospitality sanctuary in Lansdowne, Uttarakhand, where scenic valley views and mist-kissed mountains instill complete refreshment.
    </p>
    <a href="/rooms" class="btn-blue pulsing-btn" style="padding: 14px 32px; font-size: 15px; font-weight: bold;">
      <i class="fas fa-calendar-check"></i> Explore Luxury Stays
    </a>
  </div>
</div>

<section class="section-padding" style="background: #f8fafc; padding: 60px 0;">
  <div class="container">
    
    <!-- Brand Overview Grid -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: center; margin-bottom: 60px;" class="responsive-two-col">
      <div>
        <span class="section-subtitle" style="text-align: left;">32,400 Sq. Ft. Hillside Sanctuary</span>
        <h2 class="section-title" style="text-align: left; font-size: 34px;">Unmatched Comfort with Authentic Hospitality</h2>
        <p style="color: #475569; font-size: 15.5px; line-height: 1.8; margin-bottom: 18px;">
          Established on the <strong>15th of April, 2023</strong> by our owner, <strong>Mr. Bikram Gupta</strong>, Flutter Hotels & Resorts has rapidly achieved heights as a trusted and renowned hub of luxury hospitality in the Garhwal Himalayas.
        </p>
        <p style="color: #475569; font-size: 15.5px; line-height: 1.8; margin-bottom: 25px;">
          At Flutter Hotels & Resorts, we serve the needs and desires of both business and leisure travellers who are seeking unmatched comfort with authentic cuisines. Every single room features a private balcony from where you can enjoy the panoramic valley views while sipping your morning tea or coffee.
        </p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 25px;">
          <div style="background: #ffffff; padding: 18px; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; gap: 12px; align-items: center;">
            <i class="fas fa-mountain" style="font-size: 24px; color: var(--primary-blue);"></i>
            <div>
              <div style="font-size: 16px; font-weight: bold; color: var(--dark-bg);">32,400 Sq. Ft.</div>
              <span style="font-size: 12px; color: #64748b;">Spacious Estate</span>
            </div>
          </div>

          <div style="background: #ffffff; padding: 18px; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; gap: 12px; align-items: center;">
            <i class="fas fa-award" style="font-size: 24px; color: #f59e0b;"></i>
            <div>
              <div style="font-size: 16px; font-weight: bold; color: var(--dark-bg);">Est. 15 April 2023</div>
              <span style="font-size: 12px; color: #64748b;">Founded by Bikram Gupta</span>
            </div>
          </div>
        </div>

        <a href="/contact" class="btn-outline-blue" style="padding: 12px 28px; font-size: 14px; font-weight: bold;">
          <i class="fas fa-envelope"></i> Contact Our Concierge Desk
        </a>
      </div>

      <div>
        <div style="border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.08); border: 1px solid #e2e8f0;">
          <img src="/images/hotel-img-8.jpg" alt="Flutter Hotels & Resorts Lansdowne Exterior" style="width: 100%; height: 420px; object-fit: cover;">
        </div>
      </div>
    </div>

    <!-- Core Pillars Grid -->
    <div style="margin-bottom: 60px;">
      <div style="text-align: center; max-width: 700px; margin: 0 auto 40px;">
        <span class="section-subtitle">Why Guests Love Us</span>
        <h2 class="section-title">The Flutter Hospitality Promise</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px;">
        
        <!-- Pillar 1 -->
        <div style="background: #ffffff; padding: 32px; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
          <i class="fas fa-cloud-sun" style="font-size: 32px; color: var(--primary-blue); margin-bottom: 15px;"></i>
          <h4 style="font-size: 19px; color: var(--dark-bg); margin-bottom: 8px;">Private Balcony Views</h4>
          <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">
            100% of our rooms feature private balconies overlooking the mist-kissed Garhwal valleys and pine forests.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div style="background: #ffffff; padding: 32px; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
          <i class="fas fa-utensils" style="font-size: 32px; color: #22c55e; margin-bottom: 15px;"></i>
          <h4 style="font-size: 19px; color: var(--dark-bg); margin-bottom: 8px;">Authentic Multi-Cuisine</h4>
          <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">
            Chef-curated North Indian, Garhwali local specialties, Continental breakfasts, and Asian delicacies.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div style="background: #ffffff; padding: 32px; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
          <i class="fas fa-users-gear" style="font-size: 32px; color: #f59e0b; margin-bottom: 15px;"></i>
          <h4 style="font-size: 19px; color: var(--dark-bg); margin-bottom: 8px;">Banquet & MICE Venue</h4>
          <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 0;">
            Spacious conference and event spaces capable of hosting up to 200 guests for weddings, reunions & offsites.
          </p>
        </div>

      </div>
    </div>

    <!-- Image Showcase Gallery -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 50px;">
      <div style="height: 220px; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
        <img src="/images/hotel-img-5.jpeg" alt="Resort Valley View" style="width: 100%; height: 100%; object-fit: cover;">
      </div>
      <div style="height: 220px; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
        <img src="/images/resort-lawns-garden.avif" alt="Resort Lawns & Garden" style="width: 100%; height: 100%; object-fit: cover;">
      </div>
      <div style="height: 220px; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
        <img src="/images/valley-city-views.jpg" alt="Lansdowne Hillside View" style="width: 100%; height: 100%; object-fit: cover;">
      </div>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
