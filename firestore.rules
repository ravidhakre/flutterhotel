rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getAdminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             getAdminData().status == "active";
    }

    function isSuperAdmin() {
      return isAdmin() && getAdminData().role == "superAdmin";
    }

    function isPropertyAdmin(propertyId) {
      return isAdmin() && (
        getAdminData().role == "superAdmin" ||
        (getAdminData().role == "propertyAdmin" && propertyId in getAdminData().propertyIds)
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId) && request.resource.data.role == "guest";
      allow update: if isUser(userId) && 
                       request.resource.data.role == resource.data.role || 
                       isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // 2. Admins Collection
    match /admins/{adminId} {
      allow read: if isUser(adminId) || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // 3. Properties Collection
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isPropertyAdmin(propertyId);
    }

    // 4. Room Types & Rooms Collections
    match /roomTypes/{roomTypeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 5. Offers, Coupons, Packages & Addons
    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /couponUsages/{usageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /addons/{addonId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 6. Payment Orders & Verification
    match /paymentOrders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 7. Payments Collection (Strict Tamper Protection)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // 8. Refunds Collection
    match /refunds/{refundId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // 9. Payment Webhook Events Collection
    match /paymentEvents/{eventId} {
      allow read, create: if isAuthenticated();
    }

    // 10. Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAuthenticated();
    }

    // 11. User FCM Devices Collection
    match /userDevices/{deviceId} {
      allow read, create, update: if isAuthenticated();
    }

    // 12. Bookings Collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
